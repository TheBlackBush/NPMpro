{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"useBaseBranchConfig": "merge",
	"baseBranchPatterns": ["develop", "main"],
	"packageRules": [
		{ "matchBaseBranches": ["main"], "enabled": false },
		{ "matchBaseBranches": ["main"], "matchManagers": ["github-actions"], "enabled": true }
	]
}
