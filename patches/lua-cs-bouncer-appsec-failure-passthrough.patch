diff --git a/lib/crowdsec.lua b/lib/crowdsec.lua
index 0bb960f..8a4e14a 100644
--- a/lib/crowdsec.lua
+++ b/lib/crowdsec.lua
@@ -684,10 +684,25 @@ function csmod.AppSecCheck(ip)
   -- set CrowdSec APPSEC Host
   headers["host"] = runtime.conf["APPSEC_HOST"]
 
+  -- a server can let requests through when the appsec fails although APPSEC_FAILURE_ACTION is deny
+  -- (set $crowdsec_appsec_failure_passthrough 1), e.g. an admin server that must stay reachable while
+  -- the appsec is down: a working appsec still blocks, and IP decisions still apply
+  local failure_passthrough = false
   local ok, remediation, status_code = true, "allow", 200
   if runtime.conf["APPSEC_FAILURE_ACTION"] == DENY then
-    ok = false
-    remediation = runtime.conf["FALLBACK_REMEDIATION"]
+    if ngx.var.crowdsec_appsec_failure_passthrough == "1" then
+      failure_passthrough = true
+    else
+      ok = false
+      remediation = runtime.conf["FALLBACK_REMEDIATION"]
+      -- no status of our own: the ban then answers with RET_CODE (403 by default) like a LAPI ban, not with 200
+      status_code = nil
+    end
+  end
+  local function log_failure_passthrough()
+    if failure_passthrough then
+      ngx.log(ngx.WARN, "AppSec check failed, request passed through because $crowdsec_appsec_failure_passthrough is set")
+    end
   end
 
   local method = "GET"
@@ -726,6 +741,7 @@ function csmod.AppSecCheck(ip)
     -- the appsec stops reading at max_body_size (and after body_read_timeout), answers and closes
     -- the connection: on a large body we are still sending at that point and end up here
     ngx.log(ngx.ERR, "Fallback because of err: " .. err .. " (body: " .. body_len .. " bytes)")
+    log_failure_passthrough()
     return ok, remediation, status_code, {}, err
   end
 
@@ -753,8 +769,10 @@ function csmod.AppSecCheck(ip)
     end
   elseif res.status == 401 then
     ngx.log(ngx.ERR, "Unauthenticated request to APPSEC")
+    log_failure_passthrough()
   else
     ngx.log(ngx.ERR, "Bad request to APPSEC (" .. res.status .. "): " .. res.body)
+    log_failure_passthrough()
   end
 
   return ok, remediation, status_code, {}, nil
