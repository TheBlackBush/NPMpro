{
	"names": [
		["example.com", { "name": "example.com" }],
		["  Example.COM.  ", { "name": "example.com" }],
		["bücher.de", { "name": "xn--bcher-kva.de" }],
		["xn--bcher-kva.de", { "name": "xn--bcher-kva.de" }],
		["a-b.example.co.uk", { "name": "a-b.example.co.uk" }],
		["*.example.com", { "error": "error.dns-domain-wildcard" }],
		["*", { "error": "error.dns-domain-wildcard" }],
		["localhost", { "error": "error.dns-domain-one-label" }],
		["com.", { "error": "error.dns-domain-one-label" }],
		["", { "error": "error.dns-domain-invalid" }],
		["   ", { "error": "error.dns-domain-invalid" }],
		["1.2.3.4", { "error": "error.dns-domain-invalid" }],
		["1.2.3", { "error": "error.dns-domain-invalid" }],
		["[::1]", { "error": "error.dns-domain-invalid" }],
		["example.com/path", { "error": "error.dns-domain-invalid" }],
		["user@example.com", { "error": "error.dns-domain-invalid" }],
		["example.com:443", { "error": "error.dns-domain-invalid" }],
		["a b.example.com", { "error": "error.dns-domain-invalid" }],
		["_dmarc.example.com", { "error": "error.dns-domain-invalid" }],
		["-a.example.com", { "error": "error.dns-domain-invalid" }],
		["a-.example.com", { "error": "error.dns-domain-invalid" }],
		["a..example.com", { "error": "error.dns-domain-invalid" }],
		["example.com..", { "error": "error.dns-domain-invalid" }],
		["~^regex$", { "error": "error.dns-domain-invalid" }]
	],
	"zones": [
		{ "name": "example.com", "credentialId": 1, "ownerUserId": 1 },
		{ "name": "lab.example.com", "credentialId": 2, "ownerUserId": 1 },
		{ "name": "other.org", "credentialId": 1, "ownerUserId": 1 },
		{ "name": "shared.net", "credentialId": 3, "ownerUserId": 1 },
		{ "name": "shared.net", "credentialId": 4, "ownerUserId": 2 },
		{ "name": "team.io", "credentialId": 5, "ownerUserId": 2 },
		{ "name": "team.io", "credentialId": 6, "ownerUserId": 3 },
		{ "name": "xn--bcher-kva.de", "credentialId": 7, "ownerUserId": 1 }
	],
	"match": [
		{ "title": "one credential covers the zone itself, a name below it and a wildcard", "names": ["example.com", "www.example.com", "*.example.com"], "userId": 1, "expected": { "kind": "one", "credentialId": 1, "zones": ["example.com"] } },
		{ "title": "two zones of one credential", "names": ["a.example.com", "b.other.org"], "userId": 1, "expected": { "kind": "one", "credentialId": 1, "zones": ["example.com", "other.org"] } },
		{ "title": "the longest covering zone wins", "names": ["x.lab.example.com", "*.lab.example.com"], "userId": 1, "expected": { "kind": "one", "credentialId": 2, "zones": ["lab.example.com"] } },
		{ "title": "nested zones on two credentials spread the names", "names": ["a.example.com", "x.lab.example.com"], "userId": 1, "expected": { "kind": "spread", "groups": [{ "credentialId": 1, "names": ["a.example.com"] }, { "credentialId": 2, "names": ["x.lab.example.com"] }] } },
		{ "title": "case, spaces and the trailing dot do not matter", "names": [" WWW.Example.COM. "], "userId": 1, "expected": { "kind": "one", "credentialId": 1, "zones": ["example.com"] } },
		{ "title": "a name that only ends in the same letters is not covered", "names": ["notexample.com"], "userId": 1, "expected": { "kind": "none" } },
		{ "title": "no zone covers the names", "names": ["foo.test"], "userId": 1, "expected": { "kind": "none" } },
		{ "title": "no names", "names": [], "userId": 1, "expected": { "kind": "none" } },
		{ "title": "some names have no zone", "names": ["a.example.com", "foo.test"], "userId": 1, "expected": { "kind": "partial", "credentialId": 1, "uncovered": ["foo.test"] } },
		{ "title": "the user's own credential wins a tie between owners", "names": ["a.shared.net"], "userId": 1, "expected": { "kind": "one", "credentialId": 3, "zones": ["shared.net"] } },
		{ "title": "the other owner gets their own in the same tie", "names": ["a.shared.net"], "userId": 2, "expected": { "kind": "one", "credentialId": 4, "zones": ["shared.net"] } },
		{ "title": "an administrator who owns neither sees the tie as a conflict", "names": ["a.shared.net"], "userId": 9, "expected": { "kind": "conflict", "names": ["a.shared.net"], "credentialIds": [3, 4] } },
		{ "title": "a conflict wins over the covered names", "names": ["a.team.io", "b.example.com"], "userId": 1, "expected": { "kind": "conflict", "names": ["a.team.io"], "credentialIds": [5, 6] } },
		{ "title": "an IDN name matches its punycode zone", "names": ["www.bücher.de"], "userId": 1, "expected": { "kind": "one", "credentialId": 7, "zones": ["xn--bcher-kva.de"] } }
	],
	"uncovered": [
		{ "title": "a name outside the credential's zones", "credentialId": 1, "names": ["a.example.com", "x.org"], "expected": ["x.org"] },
		{ "title": "a name under another credential's zone only", "credentialId": 2, "names": ["a.example.com"], "expected": ["a.example.com"] },
		{ "title": "a shorter zone of the credential covers a nested name", "credentialId": 1, "names": ["x.lab.example.com"], "expected": [] },
		{ "title": "a wildcard name", "credentialId": 1, "names": ["*.example.com"], "expected": [] }
	]
}
