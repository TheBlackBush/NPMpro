{
	"cloudflare": {
		"one_of": ["token", "global-key"],
		"fields": [
			{ "key": "dns_cloudflare_api_token", "label": "API token", "type": "secret", "group": "token" },
			{ "key": "dns_cloudflare_email", "label": "Account email", "type": "text", "group": "global-key", "placeholder": "cloudflare@example.org" },
			{ "key": "dns_cloudflare_api_key", "label": "Global API key", "type": "secret", "group": "global-key" }
		]
	},
	"digitalocean": { "fields": [{ "key": "dns_digitalocean_token", "label": "API token", "type": "secret" }] },
	"hetzner": { "fields": [{ "key": "dns_hetzner_api_token", "label": "API token", "type": "secret" }] },
	"hetzner-cloud": { "fields": [{ "key": "dns_hetzner_cloud_api_token", "label": "API token", "type": "secret" }] },
	"ovh": {
		"fields": [
			{ "key": "dns_ovh_endpoint", "label": "Endpoint", "type": "text", "endpoint": true, "placeholder": "ovh-eu" },
			{ "key": "dns_ovh_application_key", "label": "Application key", "type": "text" },
			{ "key": "dns_ovh_application_secret", "label": "Application secret", "type": "secret" },
			{ "key": "dns_ovh_consumer_key", "label": "Consumer key", "type": "secret" }
		]
	},
	"gandi": { "fields": [{ "key": "dns_gandi_token", "label": "Personal access token", "type": "secret" }] },
	"porkbun": {
		"fields": [
			{ "key": "dns_porkbun_key", "label": "API key", "type": "secret" },
			{ "key": "dns_porkbun_secret", "label": "Secret API key", "type": "secret" }
		]
	},
	"namecheap": {
		"fields": [
			{ "key": "dns_namecheap_username", "label": "Username", "type": "text" },
			{ "key": "dns_namecheap_api_key", "label": "API key", "type": "secret" }
		]
	},
	"godaddy": {
		"fields": [
			{ "key": "dns_godaddy_key", "label": "API key", "type": "secret" },
			{ "key": "dns_godaddy_secret", "label": "API secret", "type": "secret" }
		]
	},
	"linode": {
		"fields": [
			{ "key": "dns_linode_key", "label": "API token", "type": "secret" },
			{ "key": "dns_linode_version", "label": "API version", "type": "number", "optional": true, "placeholder": "4" }
		]
	},
	"vultr": { "fields": [{ "key": "dns_vultr_key", "label": "API key", "type": "secret" }] },
	"desec": {
		"fields": [
			{ "key": "dns_desec_token", "label": "API token", "type": "secret" },
			{ "key": "dns_desec_endpoint", "label": "API endpoint", "type": "url", "optional": true, "placeholder": "https://desec.io/api/v1/" }
		]
	},
	"duckdns": { "fields": [{ "key": "dns_duckdns_token", "label": "Token", "type": "secret" }] },
	"netcup": {
		"fields": [
			{ "key": "dns_netcup_customer_id", "label": "Customer number", "type": "text" },
			{ "key": "dns_netcup_api_key", "label": "API key", "type": "secret" },
			{ "key": "dns_netcup_api_password", "label": "API password", "type": "secret" }
		]
	},
	"ionos": {
		"fields": [
			{ "key": "dns_ionos_prefix", "label": "API key prefix", "type": "text" },
			{ "key": "dns_ionos_secret", "label": "API key secret", "type": "secret" },
			{ "key": "dns_ionos_endpoint", "label": "API endpoint", "type": "url", "optional": true, "placeholder": "https://api.hosting.ionos.com" }
		]
	},
	"inwx": {
		"fields": [
			{ "key": "dns_inwx_url", "label": "API URL", "type": "url", "optional": true, "placeholder": "https://api.domrobot.com/xmlrpc/" },
			{ "key": "dns_inwx_username", "label": "Username", "type": "text" },
			{ "key": "dns_inwx_password", "label": "Password", "type": "secret" },
			{ "key": "dns_inwx_shared_secret", "label": "Two factor shared secret", "type": "secret", "optional": true }
		]
	},
	"powerdns": {
		"fields": [
			{ "key": "dns_pdns_endpoint", "label": "API endpoint", "type": "url", "placeholder": "https://pdns-api.example.com" },
			{ "key": "dns_pdns_api_key", "label": "API key", "type": "secret" },
			{ "key": "dns_pdns_server_id", "label": "Server ID", "type": "text", "optional": true, "placeholder": "localhost" },
			{ "key": "dns_pdns_disable_notify", "label": "Disable notify (true or false)", "type": "text", "optional": true, "placeholder": "false" }
		]
	},
	"rfc2136": {
		"fields": [
			{ "key": "dns_rfc2136_server", "label": "DNS server", "type": "text", "endpoint": true, "placeholder": "192.0.2.1" },
			{ "key": "dns_rfc2136_port", "label": "Port", "type": "number", "optional": true, "placeholder": "53" },
			{ "key": "dns_rfc2136_name", "label": "TSIG key name", "type": "text", "placeholder": "keyname." },
			{ "key": "dns_rfc2136_secret", "label": "TSIG key secret", "type": "secret" },
			{ "key": "dns_rfc2136_algorithm", "label": "TSIG algorithm", "type": "text", "optional": true, "placeholder": "HMAC-SHA512" }
		]
	},
	"bunny": { "fields": [{ "key": "dns_bunny_api_key", "label": "API key", "type": "secret" }] }
}
