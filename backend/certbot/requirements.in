# certbot for the image (Dockerfile). Renovate updates the pin and regenerates requirements.txt with the command in
# its header; by hand, in the image (so the Python version matches the header):
#   pip-compile --allow-unsafe --generate-hashes --output-file=requirements.txt --strip-extras requirements.in
# certbot's own DNS plugins in dns-plugins.json follow this version (backend/test/certbot-plugins.test.js).
certbot==5.10.0
