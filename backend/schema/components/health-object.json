{
	"type": "object",
	"description": "Health object",
	"additionalProperties": false,
	"required": [
		"status"
	],
	"properties": {
		"status": {
			"type": "string",
			"description": "Healthy",
			"example": "OK"
		},
		"setup": {
			"type": "boolean",
			"description": "Whether the initial setup has been completed",
			"example": true
		},
		"password": {
			"type": "boolean",
			"description": "Whether the password login is enabled",
			"example": true
		},
		"oidc": {
			"type": "object",
			"description": "OIDC login state and button",
			"additionalProperties": false,
			"required": [
				"active",
				"label",
				"color",
				"icon"
			],
			"properties": {
				"active": {
					"type": "boolean",
					"description": "Whether the OIDC login is active",
					"example": false
				},
				"label": {
					"type": "string",
					"description": "Login button text",
					"example": "OIDC"
				},
				"color": {
					"type": "string",
					"description": "Login button colour",
					"example": "#206bc4"
				},
				"icon": {
					"type": "object",
					"description": "Login button icon: a builtin icon name or the url of the uploaded file",
					"additionalProperties": false,
					"required": [
						"type"
					],
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"builtin",
								"file"
							],
							"example": "builtin"
						},
						"name": {
							"type": "string",
							"description": "Builtin icon name",
							"example": "key"
						},
						"url": {
							"type": "string",
							"description": "Icon file url",
							"example": "/api/oidc/icon?v=1761300000000"
						}
					}
				}
			}
		}
	}
}
