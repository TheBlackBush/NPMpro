{
	"type": "object",
	"description": "Stream object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"incoming_port",
		"forwarding_host",
		"forwarding_port",
		"tcp_forwarding",
		"udp_forwarding",
		"npmpro_proxy_protocol_forwarding",
		"npmpro_proxy_tls",
		"enabled",
		"npmpro_advanced_config",
		"npmpro_description",
		"certificate_id",
		"npmpro_nginx_online",
		"npmpro_nginx_err",
		"npmpro_directory",
		"npmpro_mtls_certificate_id",
		"npmpro_mtls_verify_client_optional"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"incoming_port": {
			"type": "string",
			"pattern": "^([0-9]{1,5}$|[0-9]{1,5}-[0-9]{1,5}$)",
			"maxLength": 11,
			"example": 9090
		},
		"forwarding_host": {
			"type": "string",
			"minLength": 1,
			"maxLength": 253,
			"pattern": "^[^\\s;{}\"'\\\\#]+$",
			"example": "127.0.0.1"
		},
		"forwarding_port": {
			"type": "string",
			"pattern": "^([0-9]{0,5}|\\$server_port)$",
			"maxLength": 12,
			"default": "",
			"example": 80
		},
		"tcp_forwarding": {
			"type": "boolean",
			"default": false,
			"example": true
		},
		"udp_forwarding": {
			"type": "boolean",
			"default": false,
			"example": false
		},
		"npmpro_proxy_protocol_forwarding": {
			"description": "PROXY protocol to the upstream: 0 off, 1 v1, 2 v2. UDP only sends v2, so 1 is saved as 2 there",
			"type": "integer",
			"enum": [0, 1, 2],
			"default": 0,
			"example": 0
		},
		"npmpro_proxy_tls": {
			"type": "boolean",
			"default": false,
			"example": false
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"certificate_id": {
			"$ref": "../common.json#/properties/certificate_id"
		},
		"npmpro_advanced_config": {
			"description": "Raw nginx config. Only administrators can set or change it; other users can only keep the stored value.",
			"type": "string",
			"default": "",
			"example": ""
		},
		"npmpro_nginx_online": {
			"$ref": "../common.json#/properties/npmpro_nginx_online"
		},
		"npmpro_nginx_err": {
			"$ref": "../common.json#/properties/npmpro_nginx_err"
		},
		"npmpro_directory": {
			"$ref": "../common.json#/properties/npmpro_directory"
		},
		"npmpro_mtls_certificate_id": {
			"$ref": "../common.json#/properties/npmpro_mtls_certificate_id"
		},
		"npmpro_mtls_verify_client_optional": {
			"$ref": "../common.json#/properties/npmpro_mtls_verify_client_optional"
		},
		"npmpro_description": {
			"type": "string",
			"maxLength": 255,
			"default": "",
			"example": "MariaDB database connection"
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null
		},
		"owner": {
			"$ref": "./user-object.json"
		}
	}
}
