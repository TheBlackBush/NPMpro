{
	"type": "object",
	"description": "Effective nginx runtime settings",
	"additionalProperties": false,
	"required": [
		"worker_processes",
		"worker_connections",
		"worker_shutdown_timeout",
		"log_not_found",
		"tls12",
		"force_mlkem",
		"secp_curves",
		"rsa_pkcs1",
		"module_njs",
		"module_ldap",
		"module_ntlm",
		"module_vts",
		"locked",
		"locked_by",
		"locked_reason",
		"applies",
		"restart_pending"
	],
	"properties": {
		"worker_processes": {
			"type": "string",
			"pattern": "^(auto|[1-9][0-9]{0,3})$",
			"maxLength": 4,
			"description": "Worker processes: auto or a number from 1 to cpu_count (env NGINX_WORKER_PROCESSES)"
		},
		"worker_connections": {
			"type": "integer",
			"minimum": 64,
			"maximum": 65535,
			"description": "Connections per worker process (env NGINX_WORKER_CONNECTIONS)"
		},
		"worker_shutdown_timeout": {
			"type": "string",
			"pattern": "^[0-9]+(ms|s|m|h|d|w|M|y)?([0-9]+(ms|s|m|h|d|w|M|y))*$",
			"maxLength": 32,
			"description": "How long an old worker may finish its connections after a reload: 0 or an nginx time such as 1h or 30s (env NGINX_WORKER_SHUTDOWN_TIMEOUT)"
		},
		"log_not_found": {
			"type": "boolean",
			"description": "Log requests for missing files in the error log (env NGINX_LOG_NOT_FOUND)"
		},
		"tls12": {
			"type": "boolean",
			"description": "Allow TLS 1.2 besides TLS 1.3 (env NGINX_DISABLE_TLS12, inverted); off while force_mlkem is on"
		},
		"force_mlkem": {
			"type": "boolean",
			"description": "Only offer the post-quantum key exchange X25519MLKEM768, which turns TLS 1.2 and the NIST P curves off (env NGINX_FORCE_X25519MLKEM768)"
		},
		"secp_curves": {
			"type": "boolean",
			"description": "Trust the NIST P (secp) curves (env NGINX_TRUST_SECPR1); off while force_mlkem is on"
		},
		"rsa_pkcs1": {
			"type": "boolean",
			"description": "Allow RSA PKCS#1 v1.5 signatures (env NGINX_TRUST_RSA_PKCS1)"
		},
		"module_njs": {
			"type": "boolean",
			"description": "Load the njs module (env NGINX_LOAD_NJS_MODULE)"
		},
		"module_ldap": {
			"type": "boolean",
			"description": "Load the LDAP auth module (env NGINX_LOAD_LDAP_MODULE)"
		},
		"module_ntlm": {
			"type": "boolean",
			"description": "Load the NTLM module (env NGINX_LOAD_NTLM_MODULE)"
		},
		"module_vts": {
			"type": "boolean",
			"description": "Load the virtual host traffic status module (env NGINX_LOAD_VHOST_TRAFFIC_STATUS_MODULE)"
		},
		"locked": {
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"worker_processes",
					"worker_connections",
					"worker_shutdown_timeout",
					"log_not_found",
					"tls12",
					"force_mlkem",
					"secp_curves",
					"rsa_pkcs1",
					"module_njs",
					"module_ldap",
					"module_ntlm",
					"module_vts"
				]
			},
			"description": "Fields set by environment variables or locked by force_mlkem (read only)"
		},
		"locked_by": {
			"type": "object",
			"description": "The environment variable that sets each locked field (read only)",
			"additionalProperties": false,
			"properties": {
				"worker_processes": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"worker_connections": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"worker_shutdown_timeout": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"log_not_found": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"tls12": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"force_mlkem": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"secp_curves": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"rsa_pkcs1": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"module_njs": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"module_ldap": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"module_ntlm": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				},
				"module_vts": {
					"type": "string",
					"pattern": "^[A-Z][A-Z0-9_]*$"
				}
			}
		},
		"locked_reason": {
			"type": "object",
			"description": "Fields locked by the post-quantum only setting (an indirect lock), with the reason: force-mlkem (turned on by NGINX_FORCE_X25519MLKEM768), force-mlkem-setting (turned on by the setting: not an env lock). Fields locked by their own variable are not listed.",
			"additionalProperties": false,
			"properties": {
				"tls12": {
					"type": "string",
					"enum": [
						"force-mlkem",
						"force-mlkem-setting"
					]
				},
				"secp_curves": {
					"type": "string",
					"enum": [
						"force-mlkem",
						"force-mlkem-setting"
					]
				}
			}
		},
		"applies": {
			"type": "object",
			"description": "When a change of each field takes effect",
			"additionalProperties": false,
			"required": [
				"worker_processes",
				"worker_connections",
				"worker_shutdown_timeout",
				"log_not_found",
				"tls12",
				"force_mlkem",
				"secp_curves",
				"rsa_pkcs1",
				"module_njs",
				"module_ldap",
				"module_ntlm",
				"module_vts"
			],
			"properties": {
				"worker_processes": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"worker_connections": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"worker_shutdown_timeout": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"log_not_found": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"tls12": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"force_mlkem": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"secp_curves": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"rsa_pkcs1": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"module_njs": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"module_ldap": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"module_ntlm": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				},
				"module_vts": {
					"type": "string",
					"enum": [
						"next-certificate",
						"reload",
						"immediately"
					]
				}
			}
		},
		"restart_pending": {
			"type": "array",
			"description": "Always empty: every nginx setting applies with a reload",
			"maxItems": 0,
			"items": {
				"type": "string"
			}
		},
		"cpu_count": {
			"type": "integer",
			"minimum": 1,
			"description": "CPU threads of the container, the maximum of worker_processes (read only)"
		}
	}
}
