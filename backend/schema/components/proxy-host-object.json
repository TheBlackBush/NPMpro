{
	"type": "object",
	"description": "Proxy Host object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"domain_names",
		"forward_host",
		"forward_port",
		"npmpro_access_list_type",
		"certificate_id",
		"ssl_forced",
		"advanced_config",
		"npmpro_location_config",
		"npmpro_nginx_online",
		"npmpro_nginx_err",
		"npmpro_directory",
		"npmpro_mtls_certificate_id",
		"npmpro_mtls_verify_client_optional",
		"npmpro_mtls_bypass_auth_request",
		"npmpro_http3_support",
		"forward_scheme",
		"enabled",
		"locations",
		"hsts_enabled",
		"hsts_subdomains",
		"npmpro_noindex",
		"npmpro_crowdsec_appsec",
		"npmpro_proxy_request_buffering",
		"npmpro_proxy_response_buffering",
		"npmpro_upstream_compression",
		"npmpro_fancyindex",
		"npmpro_x_frame_options",
		"npmpro_auth_request",
		"npmpro_auth_request_upstream"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"domain_names": {
			"$ref": "../common.json#/properties/domain_names"
		},
		"forward_host": {
			"type": "string",
			"maxLength": 255,
			"pattern": "^[^\\s/]{0,253}(/\\S*)?$",
			"default": "",
			"example": "127.0.0.1"
		},
		"forward_port": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535,
			"default": 0,
			"example": 8080
		},
		"npmpro_access_list_ids":{
			"$ref": "../common.json#/properties/npmpro_access_list_ids"
		},
		"npmpro_access_list_type": {
			"$ref": "../common.json#/properties/npmpro_host_access_list_type"
		},
		"certificate_id": {
			"$ref": "../common.json#/properties/certificate_id"
		},
		"ssl_forced": {
			"$ref": "../common.json#/properties/ssl_forced"
		},
		"npmpro_noindex": {
			"$ref": "../common.json#/properties/npmpro_noindex"
		},
		"npmpro_crowdsec_appsec": {
			"$ref": "../common.json#/properties/npmpro_crowdsec_appsec"
		},
		"npmpro_proxy_request_buffering": {
			"$ref": "../common.json#/properties/npmpro_proxy_request_buffering"
		},
		"npmpro_proxy_response_buffering": {
			"$ref": "../common.json#/properties/npmpro_proxy_response_buffering"
		},
		"npmpro_upstream_compression": {
			"$ref": "../common.json#/properties/npmpro_upstream_compression"
		},
		"npmpro_fancyindex": {
			"$ref": "../common.json#/properties/npmpro_fancyindex"
		},
		"npmpro_x_frame_options": {
			"type": "string",
			"enum": [
				"DENY",
				"SAMEORIGIN",
				"upstream",
				"none"
			],
			"default": "SAMEORIGIN",
			"example": "DENY"
		},
		"npmpro_auth_request": {
			"type": "string",
			"enum": [
				"none",
				"anubis",
				"tinyauth",
				"oauth2proxy",
				"voidauth",
				"authelia",
				"authentik",
				"authentik-send-basic-auth"
			],
			"default": "none",
			"example": "none"
		},
		"npmpro_auth_request_upstream": {
			"type": "string",
			"pattern": "^(https?://(([^\\s/:;{}#\"'$\\\\]+|\\[[a-fA-F0-9:]+\\]):[0-9]+|cu_[^\\s/:;{}#\"'$\\\\]+))?$",
			"maxLength": 255,
			"default": "",
			"example": ""
		},
		"advanced_config": {
			"type": "string",
			"default": "",
			"example": ""
		},
		"npmpro_location_config": {
			"type": "string",
			"default": "",
			"example": ""
		},
		"npmpro_nginx_online": {
			"$ref": "../common.json#/properties/npmpro_nginx_online"
		},
		"npmpro_nginx_err": {
			"$ref": "../common.json#/properties/npmpro_nginx_err"
		},
		"npmpro_directory": {
			"$ref": "../common.json#/properties/npmpro_directory"
		},
		"npmpro_mtls_certificate_id": {
			"$ref": "../common.json#/properties/npmpro_mtls_certificate_id"
		},
		"npmpro_mtls_verify_client_optional": {
			"$ref": "../common.json#/properties/npmpro_mtls_verify_client_optional"
		},
		"npmpro_mtls_bypass_auth_request": {
			"$ref": "../common.json#/properties/npmpro_mtls_bypass_auth_request"
		},
		"npmpro_http3_support": {
			"$ref": "../common.json#/properties/npmpro_http3_support"
		},
		"forward_scheme": {
			"type": "string",
			"enum": [
				"http",
				"https",
				"path",
				"empty",
				"grpc",
				"grpcs"
			],
			"default": "http",
			"example": "http"
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"locations": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"path"
				],
				"additionalProperties": false,
				"allOf": [
					{
						"if": {
							"properties": {
								"forward_scheme": {
									"const": "empty"
								}
							},
							"required": [
								"forward_scheme"
							]
						},
						"else": {
							"required": [
								"forward_host"
							],
							"properties": {
								"forward_host": {
									"minLength": 1
								}
							}
						}
					},
					{
						"if": {
							"properties": {
								"npmpro_access_list_type": {
									"const": "custom"
								}
							},
							"required": [
								"npmpro_access_list_type"
							]
						},
						"then": {
							"required": [
								"npmpro_access_list_ids"
							],
							"properties": {
								"npmpro_access_list_ids": {
									"minItems": 1
								}
							}
						}
					}
				],
				"properties": {
					"npmpro_enabled": {
						"$ref": "../common.json#/properties/enabled"
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 255,
						"pattern": "^\\S+$"
					},
					"location_type": {
						"type": "string",
						"enum": [
							"",
							"@",
							"= ",
							"~ ",
							"~* ",
							"^~ "
						],
						"default": ""
					},
					"forward_scheme": {
						"$ref": "#/properties/forward_scheme"
					},
					"forward_host": {
						"$ref": "#/properties/forward_host"
					},
					"forward_port": {
						"$ref": "#/properties/forward_port"
					},
					"npmpro_noindex": {
						"$ref": "#/properties/npmpro_noindex"
					},
					"npmpro_crowdsec_appsec": {
						"$ref": "#/properties/npmpro_crowdsec_appsec"
					},
					"npmpro_proxy_request_buffering": {
						"$ref": "#/properties/npmpro_proxy_request_buffering"
					},
					"npmpro_proxy_response_buffering": {
						"$ref": "#/properties/npmpro_proxy_response_buffering"
					},
					"npmpro_upstream_compression": {
						"$ref": "#/properties/npmpro_upstream_compression"
					},
					"npmpro_fancyindex": {
						"$ref": "#/properties/npmpro_fancyindex"
					},
					"npmpro_x_frame_options": {
						"$ref": "#/properties/npmpro_x_frame_options"
					},
					"npmpro_auth_request": {
						"$ref": "#/properties/npmpro_auth_request"
					},
					"npmpro_auth_request_upstream": {
						"$ref": "#/properties/npmpro_auth_request_upstream"
					},
					"advanced_config": {
						"type": "string",
						"default": ""
					},
					"npmpro_access_list_ids":{
						"$ref": "../common.json#/properties/npmpro_access_list_ids"
					},
					"npmpro_access_list_type": {
						"$ref": "../common.json#/properties/npmpro_location_access_list_type"
					}
				}
			},
			"default": [],
			"example": [
				{
					"path": "/app",
					"forward_scheme": "http",
					"forward_host": "example.com",
					"forward_port": 80,
					"npmpro_access_list_ids": [1, 2],
					"npmpro_access_list_type": "custom"
				}
			]
		},
		"hsts_enabled": {
			"$ref": "../common.json#/properties/hsts_enabled"
		},
		"hsts_subdomains": {
			"$ref": "../common.json#/properties/hsts_subdomains"
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null",
					"example": null
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null
		},
		"owner": {
			"$ref": "./user-object.json"
		},
		"access_lists": {
			"type": "array",
			"items": {
				"$ref": "./access-list-object.json"
			},
			"example": []
		}
	}
}
