{
	"type": "object",
	"description": "Proxy Host object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"domain_names",
		"forward_host",
		"forward_port",
		"npmpro_access_list_type",
		"certificate_id",
		"ssl_forced",
		"advanced_config",
		"npmpro_location_config",
		"npmpro_nginx_online",
		"npmpro_nginx_err",
		"npmpro_directory",
		"npmpro_description",
		"npmpro_tags",
		"npmpro_mtls_certificate_id",
		"npmpro_mtls_verify_client_optional",
		"npmpro_mtls_bypass_auth_request",
		"npmpro_http3_support",
		"forward_scheme",
		"enabled",
		"locations",
		"hsts_enabled",
		"hsts_subdomains",
		"npmpro_noindex",
		"npmpro_maintenance",
		"npmpro_page_not_found",
		"npmpro_page_upstream",
		"npmpro_page_maintenance",
		"npmpro_crowdsec_appsec",
		"npmpro_proxy_request_buffering",
		"npmpro_proxy_response_buffering",
		"npmpro_upstream_compression",
		"npmpro_fancyindex",
		"npmpro_x_frame_options",
		"npmpro_auth_request",
		"npmpro_auth_request_upstream"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"domain_names": {
			"$ref": "../common.json#/properties/domain_names"
		},
		"forward_host": {
			"type": "string",
			"maxLength": 255,
			"pattern": "^[^\\s/;{}\"'\\\\#]{0,253}(/[^\\s;{}\"'\\\\#]*)?$",
			"default": "",
			"example": "127.0.0.1",
			"description": "Address of the upstream server: a host name or IP address, with an optional path after it (`10.0.0.5/app`). A name starting with `cu_` refers to a custom upstream block (leave the port empty then). With the `path` scheme it is the folder to serve. Required unless forward_scheme is `empty`."
		},
		"forward_port": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535,
			"default": 0,
			"example": 8080,
			"description": "Port of the upstream server, 0 to 65535. With the `path` scheme a value above 0 hands PHP files to the PHP-FPM socket of that number; 0 serves files only."
		},
		"npmpro_access_list_ids": {
			"$ref": "../common.json#/properties/npmpro_access_list_ids"
		},
		"npmpro_access_list_type": {
			"$ref": "../common.json#/properties/npmpro_host_access_list_type"
		},
		"certificate_id": {
			"$ref": "../common.json#/properties/certificate_id"
		},
		"ssl_forced": {
			"$ref": "../common.json#/properties/ssl_forced"
		},
		"npmpro_noindex": {
			"$ref": "../common.json#/properties/npmpro_noindex"
		},
		"npmpro_maintenance": {
			"$ref": "../common.json#/properties/npmpro_maintenance"
		},
		"npmpro_page_not_found": {
			"$ref": "../common.json#/properties/npmpro_page_not_found"
		},
		"npmpro_page_upstream": {
			"$ref": "../common.json#/properties/npmpro_page_upstream"
		},
		"npmpro_page_maintenance": {
			"$ref": "../common.json#/properties/npmpro_page_maintenance"
		},
		"npmpro_page_not_found_html": {
			"$ref": "../common.json#/properties/npmpro_page_html"
		},
		"npmpro_page_upstream_html": {
			"$ref": "../common.json#/properties/npmpro_page_html"
		},
		"npmpro_page_maintenance_html": {
			"$ref": "../common.json#/properties/npmpro_page_html"
		},
		"npmpro_crowdsec_appsec": {
			"$ref": "../common.json#/properties/npmpro_crowdsec_appsec"
		},
		"npmpro_proxy_request_buffering": {
			"$ref": "../common.json#/properties/npmpro_proxy_request_buffering"
		},
		"npmpro_proxy_response_buffering": {
			"$ref": "../common.json#/properties/npmpro_proxy_response_buffering"
		},
		"npmpro_upstream_compression": {
			"$ref": "../common.json#/properties/npmpro_upstream_compression"
		},
		"npmpro_fancyindex": {
			"$ref": "../common.json#/properties/npmpro_fancyindex"
		},
		"npmpro_x_frame_options": {
			"type": "string",
			"enum": [
				"DENY",
				"SAMEORIGIN",
				"upstream",
				"none"
			],
			"default": "SAMEORIGIN",
			"example": "DENY",
			"description": "What the X-Frame-Options header does: `DENY` and `SAMEORIGIN` send that value, `upstream` leaves the upstream's own header alone, `none` removes it."
		},
		"npmpro_auth_request": {
			"type": "string",
			"enum": [
				"none",
				"anubis",
				"tinyauth",
				"oauth2proxy",
				"voidauth",
				"authelia",
				"authentik",
				"authentik-send-basic-auth"
			],
			"default": "none",
			"example": "none",
			"description": "Forward authentication provider that has to approve each request before it is served, or `none`. The provider's upstream is npmpro_auth_request_upstream."
		},
		"npmpro_auth_request_upstream": {
			"type": "string",
			"pattern": "^(https?://(([^\\s/:;{}#\"'$\\\\]+|\\[[a-fA-F0-9:]+\\]):[0-9]+|cu_[^\\s/:;{}#\"'$\\\\]+))?$",
			"maxLength": 255,
			"default": "",
			"example": "",
			"description": "Address of the Auth Request provider, such as `http://10.0.0.8:9091`, or the scheme and name of a custom upstream (`http://cu_myauth`). Empty uses the upstream set for the provider in the environment. Always saved empty while npmpro_auth_request is `none`."
		},
		"advanced_config": {
			"description": "Raw nginx config. Only administrators can set or change it; other users can only keep the stored value.",
			"type": "string",
			"default": "",
			"example": ""
		},
		"npmpro_location_config": {
			"description": "Raw nginx config. Only administrators can set or change it; other users can only keep the stored value.",
			"type": "string",
			"default": "",
			"example": ""
		},
		"npmpro_nginx_online": {
			"$ref": "../common.json#/properties/npmpro_nginx_online"
		},
		"npmpro_nginx_err": {
			"$ref": "../common.json#/properties/npmpro_nginx_err"
		},
		"npmpro_directory": {
			"$ref": "../common.json#/properties/npmpro_directory"
		},
		"npmpro_description": {
			"$ref": "../common.json#/properties/npmpro_description"
		},
		"npmpro_tags": {
			"$ref": "../common.json#/properties/npmpro_tags"
		},
		"npmpro_mtls_certificate_id": {
			"$ref": "../common.json#/properties/npmpro_mtls_certificate_id"
		},
		"npmpro_mtls_verify_client_optional": {
			"$ref": "../common.json#/properties/npmpro_mtls_verify_client_optional"
		},
		"npmpro_mtls_bypass_auth_request": {
			"$ref": "../common.json#/properties/npmpro_mtls_bypass_auth_request"
		},
		"npmpro_http3_support": {
			"$ref": "../common.json#/properties/npmpro_http3_support"
		},
		"forward_scheme": {
			"description": "\"path\" serves files from forward_host. Non-administrators can only use an absolute path inside /var/www (or keep the stored path).",
			"type": "string",
			"enum": [
				"http",
				"https",
				"path",
				"empty",
				"grpc",
				"grpcs"
			],
			"default": "http",
			"example": "http"
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"locations": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"path"
				],
				"additionalProperties": false,
				"allOf": [
					{
						"if": {
							"properties": {
								"forward_scheme": {
									"const": "empty"
								}
							},
							"required": [
								"forward_scheme"
							]
						},
						"else": {
							"required": [
								"forward_host"
							],
							"properties": {
								"forward_host": {
									"minLength": 1
								}
							}
						}
					},
					{
						"if": {
							"properties": {
								"npmpro_access_list_type": {
									"const": "custom"
								}
							},
							"required": [
								"npmpro_access_list_type"
							]
						},
						"then": {
							"required": [
								"npmpro_access_list_ids"
							],
							"properties": {
								"npmpro_access_list_ids": {
									"minItems": 1
								}
							}
						}
					}
				],
				"properties": {
					"npmpro_enabled": {
						"$ref": "../common.json#/properties/enabled"
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 255,
						"pattern": "^\\S+$",
						"description": "Path the location matches, for example `/api`, without whitespace. How it matches depends on location_type."
					},
					"location_type": {
						"type": "string",
						"enum": [
							"",
							"@",
							"= ",
							"~ ",
							"~* ",
							"^~ "
						],
						"default": "",
						"description": "How path is matched: empty is a prefix, `= ` exact, `~ ` a case sensitive regular expression, `~* ` a case insensitive one, `^~ ` a prefix that skips regular expressions, `@` a named location. The trailing space belongs to the value."
					},
					"forward_scheme": {
						"$ref": "#/properties/forward_scheme"
					},
					"forward_host": {
						"$ref": "#/properties/forward_host",
						"description": "Upstream address of the location, with the same rules as the host's forward_host. Required unless its forward_scheme is `empty`."
					},
					"forward_port": {
						"$ref": "#/properties/forward_port",
						"description": "Upstream port of the location, with the same rules as the host's forward_port."
					},
					"npmpro_noindex": {
						"$ref": "#/properties/npmpro_noindex"
					},
					"npmpro_crowdsec_appsec": {
						"$ref": "#/properties/npmpro_crowdsec_appsec"
					},
					"npmpro_proxy_request_buffering": {
						"$ref": "#/properties/npmpro_proxy_request_buffering"
					},
					"npmpro_proxy_response_buffering": {
						"$ref": "#/properties/npmpro_proxy_response_buffering"
					},
					"npmpro_upstream_compression": {
						"$ref": "#/properties/npmpro_upstream_compression"
					},
					"npmpro_fancyindex": {
						"$ref": "#/properties/npmpro_fancyindex"
					},
					"npmpro_x_frame_options": {
						"$ref": "#/properties/npmpro_x_frame_options",
						"description": "X-Frame-Options of the location, with the same values as the host's."
					},
					"npmpro_auth_request": {
						"description": "global (Same as host) uses the host's Auth Request and its upstream; none makes the location public on purpose. New locations default to global.",
						"type": "string",
						"enum": [
							"global",
							"none",
							"anubis",
							"tinyauth",
							"oauth2proxy",
							"voidauth",
							"authelia",
							"authentik",
							"authentik-send-basic-auth"
						],
						"default": "global",
						"example": "global"
					},
					"npmpro_auth_request_upstream": {
						"$ref": "#/properties/npmpro_auth_request_upstream",
						"description": "Auth Request upstream of the location. Always saved empty while its Auth Request is `none` or `global`."
					},
					"advanced_config": {
						"description": "Raw nginx config. Only administrators can set or change it; other users can only keep the stored value.",
						"type": "string",
						"default": ""
					},
					"npmpro_access_list_ids": {
						"$ref": "../common.json#/properties/npmpro_access_list_ids"
					},
					"npmpro_access_list_type": {
						"$ref": "../common.json#/properties/npmpro_location_access_list_type"
					}
				}
			},
			"default": [],
			"example": [
				{
					"path": "/app",
					"forward_scheme": "http",
					"forward_host": "example.com",
					"forward_port": 80,
					"npmpro_access_list_ids": [
						1,
						2
					],
					"npmpro_access_list_type": "custom"
				}
			],
			"description": "Custom locations: other paths of the host sent to their own upstream, in the order given. A save replaces the whole list. An answer also carries each location's id, proxy_host_id and access_lists, which are not in this schema."
		},
		"hsts_enabled": {
			"$ref": "../common.json#/properties/hsts_enabled"
		},
		"hsts_subdomains": {
			"$ref": "../common.json#/properties/hsts_subdomains"
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null",
					"example": null
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null,
			"description": "The host's certificate, null when it has none. Only the list answer carries it, and only with `expand=certificate`."
		},
		"owner": {
			"$ref": "./user-object.json",
			"description": "The user who created the host. Only the list answer carries it, and only with `expand=owner`."
		},
		"access_lists": {
			"type": "array",
			"items": {
				"$ref": "./proxy-host-access-list-object.json"
			},
			"example": [],
			"description": "The access lists applied to the host itself, in the order they were chosen. Set npmpro_access_list_ids to change them; a request never sends this field."
		}
	}
}
