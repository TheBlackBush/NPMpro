{
	"type": "object",
	"description": "Active CrowdSec decisions read with the bouncer API key. After a failed poll the last list is kept with its fetched_at",
	"additionalProperties": false,
	"required": [
		"configured",
		"reachable",
		"error",
		"fetched_at",
		"total",
		"added_24h",
		"by_scenario",
		"by_origin",
		"by_type",
		"newest",
		"countries"
	],
	"properties": {
		"configured": {
			"type": "boolean",
			"description": "The bouncer is enabled and has an API key or TLS client certificate"
		},
		"reachable": {
			"type": "boolean",
			"description": "The last poll succeeded"
		},
		"error": {
			"type": [
				"string",
				"null"
			],
			"description": "Why the last poll failed, null when it succeeded"
		},
		"fetched_at": {
			"type": [
				"string",
				"null"
			],
			"format": "date-time",
			"description": "When the decisions were last read, null before the first successful poll"
		},
		"total": {
			"type": "integer",
			"minimum": 0,
			"description": "Number of active decisions"
		},
		"added_24h": {
			"type": "integer",
			"minimum": 0,
			"description": "Decisions first seen within the last 24 hours (restarts with the backend)"
		},
		"by_scenario": {
			"type": "array",
			"description": "Sorted by count, descending",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"scenario",
					"count"
				],
				"properties": {
					"scenario": {
						"type": "string",
						"description": "CrowdSec scenario that caused the decisions"
					},
					"count": {
						"type": "integer",
						"minimum": 1,
						"description": "Number of active decisions of this scenario"
					}
				}
			}
		},
		"by_origin": {
			"type": "array",
			"description": "Sorted by count, descending",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"origin",
					"count"
				],
				"properties": {
					"origin": {
						"type": "string",
						"description": "Where the decisions come from, such as `crowdsec`, `cscli` or `CAPI`"
					},
					"count": {
						"type": "integer",
						"minimum": 1,
						"description": "Number of active decisions from this origin"
					}
				}
			}
		},
		"by_type": {
			"type": "array",
			"description": "Sorted by count, descending",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"type",
					"count"
				],
				"properties": {
					"type": {
						"type": "string",
						"description": "Decision type, such as `ban` or `captcha`"
					},
					"count": {
						"type": "integer",
						"minimum": 1,
						"description": "Number of active decisions of this type"
					}
				}
			}
		},
		"newest": {
			"type": "array",
			"maxItems": 100,
			"description": "Highest id first",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer",
						"description": "CrowdSec decision ID"
					},
					"value": {
						"type": "string",
						"description": "IP or range"
					},
					"scope": {
						"type": "string",
						"description": "What the value is: `Ip`, `Range` or another CrowdSec scope"
					},
					"scenario": {
						"type": "string",
						"description": "CrowdSec scenario that caused the decision"
					},
					"origin": {
						"type": "string",
						"description": "Where the decision comes from"
					},
					"type": {
						"type": "string",
						"description": "Decision type, such as `ban`"
					},
					"duration": {
						"type": "string",
						"description": "Time left as reported by CrowdSec (Go duration)"
					},
					"seconds_left": {
						"type": "integer",
						"minimum": 0,
						"description": "Seconds until the decision ends"
					},
					"country": {
						"type": [
							"string",
							"null"
						],
						"description": "ISO 3166-1 alpha-2 country code of an IP decision, null when unknown"
					}
				},
				"additionalProperties": false,
				"required": [
					"id",
					"value",
					"scope",
					"scenario",
					"origin",
					"type",
					"duration",
					"seconds_left",
					"country"
				]
			}
		},
		"countries": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"country",
					"count"
				],
				"properties": {
					"country": {
						"type": "string",
						"description": "ISO 3166-1 alpha-2 country code"
					},
					"count": {
						"type": "integer",
						"minimum": 1,
						"description": "Number of active decisions for this country"
					}
				}
			},
			"description": "Active decisions per country, most first"
		}
	}
}
