{
	"operationId": "createSetupUser",
	"summary": "Create the first administrator",
	"tags": [
		"public"
	],
	"requestBody": {
		"description": "User Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"name",
						"email",
						"auth"
					],
					"properties": {
						"name": {
							"$ref": "../../../components/user-object.json#/properties/name"
						},
						"email": {
							"$ref": "../../../components/user-object.json#/properties/email"
						},
						"auth": {
							"type": "object",
							"description": "Password sign-in for the user: the type is `password` and the secret is 8 to 255 characters",
							"additionalProperties": false,
							"required": [
								"type",
								"secret"
							],
							"properties": {
								"type": {
									"type": "string",
									"enum": [
										"password"
									],
									"description": "Always `password`"
								},
								"secret": {
									"type": "string",
									"minLength": 8,
									"maxLength": 255,
									"description": "The password, 8 to 255 characters"
								}
							},
							"example": {
								"type": "password",
								"secret": "your-password"
							}
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"name": "Admin User",
							"email": "admin@example.com",
							"auth": {
								"type": "password",
								"secret": "your-password"
							}
						}
					}
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "The created administrator",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/user-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"is_disabled": false,
								"email": "admin@example.com",
								"name": "Admin User",
								"avatar": "//www.gravatar.com/avatar/5c1f7a9e3b2d4c6f8a0e1b3d5f7a9c2e?default=mm",
								"roles": [
									"admin"
								]
							}
						}
					}
				}
			}
		}
	},
	"description": "Creates the first user of a new instance: always an administrator, with a password. It works only while no user exists and then answers 403. Failed requests count toward a limit of 5 per 5 minutes for each address.\n\nNeeds: nothing (public, only while no user exists)"
}
