{
	"operationId": "regenUserMfaBackupCodes",
	"summary": "Create new backup codes",
	"tags": [
		"Users"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "userID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"description": "ID of your own user. `me` is also accepted for the signed-in user",
			"example": 2
		}
	],
	"requestBody": {
		"description": "Verification Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"additionalProperties": false,
					"properties": {
						"code": {
							"minLength": 6,
							"maxLength": 8,
							"type": "string",
							"example": "123456",
							"description": "A current code (6 digits) from the authenticator"
						}
					},
					"required": [
						"code"
					],
					"type": "object"
				},
				"examples": {
					"default": {
						"value": {
							"code": "123456"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"backup_codes": [
									"CODE0001",
									"CODE0002",
									"CODE0003",
									"CODE0004",
									"CODE0005",
									"CODE0006",
									"CODE0007",
									"CODE0008"
								]
							}
						}
					},
					"schema": {
						"type": "object",
						"required": [
							"backup_codes"
						],
						"additionalProperties": false,
						"properties": {
							"backup_codes": {
								"description": "Backup codes",
								"example": [
									"6CD7CB06",
									"495302F3",
									"D8037852",
									"A6FFC956",
									"BC1A1851",
									"A05E644F",
									"A406D2E8",
									"0AE3C522"
								],
								"type": "array",
								"items": {
									"type": "string",
									"example": "6CD7CB06"
								}
							}
						}
					}
				}
			},
			"description": "The new backup codes, shown once"
		}
	},
	"description": "Replaces the backup codes of your own account with new ones, shown once in the answer. The old codes stop working and your other sessions end. Needs a current 6 digit code from your authenticator (400 when wrong or MFA is not on). The answer sets a fresh session cookie.\n\nNeeds: a signed-in session as that user (API tokens are refused)"
}
