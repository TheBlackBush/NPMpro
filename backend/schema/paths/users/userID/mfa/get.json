{
	"operationId": "getUserMfaStatus",
	"summary": "Get the MFA state of a user",
	"tags": [
		"Users"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "userID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"description": "ID of the user",
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The MFA state",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"totp_enabled": true,
								"backup_codes_remaining": 8
							}
						}
					},
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"totp_enabled",
							"backup_codes_remaining"
						],
						"properties": {
							"totp_enabled": {
								"type": "boolean",
								"description": "Is TOTP enabled for this user",
								"example": true
							},
							"backup_codes_remaining": {
								"type": "integer",
								"description": "Number of remaining backup codes for this user",
								"example": 5
							}
						}
					}
				}
			}
		}
	},
	"description": "Says whether TOTP is on for a user and how many backup codes are left. The codes themselves are never returned.\n\nNeeds: a signed-in session as that user or as an administrator (API tokens are refused)"
}
