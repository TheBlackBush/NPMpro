{
	"operationId": "updateUser",
	"summary": "Update a user",
	"tags": [
		"Users"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "userID",
			"schema": {
				"oneOf": [
					{
						"type": "string",
						"pattern": "^me$"
					},
					{
						"type": "integer",
						"minimum": 1
					}
				]
			},
			"required": true,
			"description": "ID of the user. `me` is also accepted for the signed-in user",
			"example": 2
		}
	],
	"requestBody": {
		"description": "User Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"name": {
							"$ref": "../../../components/user-object.json#/properties/name"
						},
						"email": {
							"$ref": "../../../components/user-object.json#/properties/email"
						},
						"roles": {
							"$ref": "../../../components/user-object.json#/properties/roles"
						},
						"is_disabled": {
							"$ref": "../../../components/user-object.json#/properties/is_disabled"
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"name": "Jane Roe",
							"email": "jane@example.com"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The updated user",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 2,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"is_disabled": false,
								"email": "jane@example.com",
								"name": "Jane Roe",
								"avatar": "//www.gravatar.com/avatar/0f3a8c5d9e1b4a7c2d6e8f0a1b3c5d7e?default=mm",
								"roles": []
							}
						}
					},
					"schema": {
						"$ref": "../../../components/user-object.json"
					}
				}
			}
		},
		"403": {
			"description": "Not allowed: API tokens are refused here, use a signed-in session. The answer is an error with the message `API tokens cannot manage users`."
		}
	},
	"description": "Changes the name, email, roles or disabled state of a user; only the fields sent change. Changing roles needs an administrator, and nobody can change their own roles or disable themselves (403). Disabling a user ends their sessions and stops their API tokens.\n\nNeeds: a signed-in session as that user or as an administrator (API tokens are refused)"
}
