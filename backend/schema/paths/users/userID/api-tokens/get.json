{
	"operationId": "getOwnApiTokens",
	"summary": "List your API tokens",
	"tags": [
		"API Tokens"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "userID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"description": "ID of the signed-in user. `me` is also accepted; another user's ID is refused with 403",
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The signed-in user's API tokens, newest first",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"name": "deploy script",
									"prefix": "npmpro_3f9c2a7d1b4e8f60",
									"visibility": "user",
									"permissions": {
										"proxy_hosts": "manage",
										"redirection_hosts": "view",
										"dead_hosts": "hidden",
										"streams": "hidden",
										"access_lists": "view",
										"certificates": "view"
									},
									"admin": false,
									"allow_delete": false,
									"expires_on": "2027-02-15T09:30:00.000Z",
									"last_used_on": null,
									"created_on": "2026-11-17T09:30:00.000Z",
									"expired": false
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../../components/api-token-list.json"
					}
				}
			}
		},
		"403": {
			"description": "403 response"
		}
	},
	"description": "Lists the API tokens of the signed-in user, newest first, with their permissions, expiry and last use. The token text is never in the list: only its `prefix` identifies it.\n\nNeeds: a signed-in session (API tokens are refused)"
}
