{
	"operationId": "getOwnApiTokens",
	"summary": "List the API tokens of the signed-in user",
	"tags": [
		"API Tokens"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "userID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"description": "User ID (the signed-in user)",
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"name": "ci",
									"prefix": "npmpro_0123456789abcdef",
									"visibility": "user",
									"permissions": {
										"proxy_hosts": "view",
										"redirection_hosts": "view",
										"dead_hosts": "view",
										"streams": "view",
										"access_lists": "view",
										"certificates": "view"
									},
									"admin": false,
									"allow_delete": false,
									"expires_on": "2027-02-15T12:00:00.000Z",
									"last_used_on": null,
									"created_on": "2026-11-17T12:00:00.000Z",
									"expired": false
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../../components/api-token-list.json"
					}
				}
			}
		},
		"403": {
			"description": "403 response"
		}
	}
}
