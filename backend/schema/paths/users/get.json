{
	"operationId": "getUsers",
	"summary": "List users",
	"tags": [
		"Users"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The users, ordered by name",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"created_on": "2026-11-17T09:30:00.000Z",
									"modified_on": "2026-11-17T09:30:00.000Z",
									"is_disabled": false,
									"email": "admin@example.com",
									"name": "Admin User",
									"avatar": "//www.gravatar.com/avatar/5c1f7a9e3b2d4c6f8a0e1b3d5f7a9c2e?default=mm",
									"roles": [
										"admin"
									],
									"npmpro_has_password": true
								},
								{
									"id": 2,
									"created_on": "2026-11-17T09:30:00.000Z",
									"modified_on": "2026-11-17T09:30:00.000Z",
									"is_disabled": false,
									"email": "jane@example.com",
									"name": "Jane Doe",
									"avatar": "//www.gravatar.com/avatar/0f3a8c5d9e1b4a7c2d6e8f0a1b3c5d7e?default=mm",
									"roles": [],
									"npmpro_has_password": true
								}
							]
						}
					},
					"schema": {
						"$ref": "../../components/user-list.json"
					}
				}
			}
		},
		"403": {
			"description": "Not allowed: API tokens are refused here, use a signed-in session. The answer is an error with the message `API tokens cannot manage users`."
		}
	},
	"description": "Lists every user, ordered by name. Each user carries `npmpro_has_password`, but the answer never holds a password, a secret or a token.\n\nNeeds: a signed-in session of an administrator (API tokens are refused)"
}
