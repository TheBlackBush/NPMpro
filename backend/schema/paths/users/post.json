{
	"operationId": "createUser",
	"summary": "Create a user",
	"tags": [
		"users"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "User Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"name",
						"email"
					],
					"properties": {
						"name": {
							"$ref": "../../components/user-object.json#/properties/name"
						},
						"email": {
							"$ref": "../../components/user-object.json#/properties/email"
						},
						"roles": {
							"$ref": "../../components/user-object.json#/properties/roles"
						},
						"is_disabled": {
							"$ref": "../../components/user-object.json#/properties/is_disabled"
						},
						"auth": {
							"type": "object",
							"description": "Password sign-in for the user: the type is `password` and the secret is 8 to 255 characters",
							"additionalProperties": false,
							"required": [
								"type",
								"secret"
							],
							"properties": {
								"type": {
									"type": "string",
									"enum": [
										"password"
									],
									"description": "Always `password`"
								},
								"secret": {
									"type": "string",
									"minLength": 8,
									"maxLength": 255,
									"description": "The password, 8 to 255 characters"
								}
							},
							"example": {
								"type": "password",
								"secret": "your-password"
							}
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"name": "Jane Doe",
							"email": "jane@example.com",
							"roles": [],
							"auth": {
								"type": "password",
								"secret": "your-password"
							}
						}
					}
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "The created user",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 2,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"is_disabled": false,
								"email": "jane@example.com",
								"name": "Jane Doe",
								"avatar": "//www.gravatar.com/avatar/0f3a8c5d9e1b4a7c2d6e8f0a1b3c5d7e?default=mm",
								"roles": []
							}
						}
					},
					"schema": {
						"$ref": "../../components/user-object.json"
					}
				}
			}
		},
		"403": {
			"description": "Not allowed: API tokens are refused here, use a signed-in session. The answer is an error with the message `API tokens cannot manage users`."
		}
	},
	"description": "Creates a user with the permissions all hidden (visibility is all for an administrator, own items for others), and a password when `auth` is given. Set the permissions afterwards with the permissions route. The email is stored in lower case and must not be in use (400).\n\nNeeds: a signed-in session of an administrator (API tokens are refused)"
}
