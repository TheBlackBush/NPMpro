{
	"operationId": "deleteDdnsRecord",
	"summary": "Delete a dynamic DNS record",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "recordID",
			"description": "ID of the dynamic DNS record, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"responses": {
		"200": {
			"description": "The record that was deleted",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-24T09:30:00.000Z",
								"modified_on": "2026-11-24T09:35:00.000Z",
								"owner_user_id": 1,
								"dns_credential_id": 1,
								"provider": "cloudflare",
								"name": "home.example.com",
								"zone": "example.com",
								"kind": "address",
								"target": null,
								"ip_version": "ipv4",
								"ipv6_suffix": null,
								"ttl": null,
								"enabled": true,
								"state": "ok",
								"last_ipv4": "81.2.69.160",
								"last_ipv6": null,
								"last_checked_on": "2026-11-24T09:35:00.000Z",
								"last_changed_on": "2026-11-24T09:30:00.000Z",
								"next_try_on": null,
								"failures": 0,
								"error": null,
								"error_i18n": null,
								"error_values": null,
								"proxied": false
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/ddns-record-object.json"
					}
				}
			}
		}
	},
	"description": "Deletes the record from NPMpro for good, with its history. The record at the DNS provider is left as it is.\n\nNeeds: Certificates manage and the token's Allow delete switch"
}
