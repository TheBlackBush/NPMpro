{
	"operationId": "updateDdnsRecordNow",
	"summary": "Update a dynamic DNS record now",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "recordID",
			"description": "ID of the dynamic DNS record, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"responses": {
		"200": {
			"description": "The record after the run",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-24T09:30:00.000Z",
								"modified_on": "2026-11-24T09:35:00.000Z",
								"owner_user_id": 1,
								"dns_credential_id": 1,
								"provider": "cloudflare",
								"name": "home.example.com",
								"zone": "example.com",
								"kind": "address",
								"target": null,
								"ip_version": "ipv4",
								"ipv6_suffix": null,
								"ttl": null,
								"enabled": true,
								"state": "ok",
								"last_ipv4": "81.2.69.160",
								"last_ipv6": null,
								"last_checked_on": "2026-11-24T09:35:00.000Z",
								"last_changed_on": "2026-11-24T09:30:00.000Z",
								"next_try_on": null,
								"failures": 0,
								"error": null,
								"error_i18n": null,
								"error_values": null,
								"proxied": false
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/ddns-record-object.json"
					}
				}
			}
		}
	},
	"description": "Checks the record at once and writes it when it differs, ignoring its retry time. After a write the cooldown holds: a second write inside it answers 400 (`error.ddns-cooldown`) with the time the next write is allowed. A disabled record is refused with a 400, and the answer is 409 while the updater is paused. The answer is the record, a failed run included (see `state` and `error`).\n\nNeeds: Certificates manage"
}
