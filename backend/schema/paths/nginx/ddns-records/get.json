{
	"operationId": "getDdnsRecords",
	"summary": "List dynamic DNS records",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to each record: `credential` (the DNS credential, without its values) or `owner` (the user who created it)",
			"schema": {
				"type": "string",
				"enum": [
					"credential",
					"owner"
				]
			}
		},
		{
			"in": "query",
			"name": "query",
			"description": "Only records whose name contains this text",
			"schema": {
				"type": "string"
			}
		}
	],
	"responses": {
		"200": {
			"description": "The dynamic DNS records, ordered by name",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"created_on": "2026-11-24T09:30:00.000Z",
									"modified_on": "2026-11-24T09:35:00.000Z",
									"owner_user_id": 1,
									"dns_credential_id": 1,
									"provider": "cloudflare",
									"name": "home.example.com",
									"zone": "example.com",
									"kind": "address",
									"target": null,
									"ip_version": "ipv4",
									"ipv6_suffix": null,
									"ttl": null,
									"enabled": true,
									"state": "ok",
									"last_ipv4": "81.2.69.160",
									"last_ipv6": null,
									"last_checked_on": "2026-11-24T09:35:00.000Z",
									"last_changed_on": "2026-11-24T09:30:00.000Z",
									"next_try_on": null,
									"failures": 0,
									"error": null,
									"error_i18n": null,
									"error_values": null,
									"proxied": false
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../components/ddns-record-list.json"
					}
				}
			}
		}
	},
	"description": "Lists the dynamic DNS records, ordered by name. A user limited to their own items sees only the records of their own credentials.\n\nNeeds: Certificates view"
}
