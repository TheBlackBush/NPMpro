{
	"operationId": "updateProxyHost",
	"summary": "Update a Proxy Host",
	"tags": [
		"proxy-hosts"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "The ID of the Proxy Host",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"requestBody": {
		"description": "Proxy Host Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"allOf": [
						{
							"if": {
								"properties": {
									"npmpro_dns_challenge": {
										"type": "boolean",
										"const": true
									}
								},
								"required": [
									"npmpro_dns_challenge"
								]
							},
							"then": {
								"required": [
									"npmpro_dns_provider",
									"npmpro_dns_credential_id"
								]
							}
						},
						{
							"if": {
								"properties": {
									"certificate_id": {
										"const": "new"
									}
								},
								"required": [
									"certificate_id"
								]
							},
							"then": {
								"if": {
									"properties": {
										"npmpro_dns_challenge": {
											"type": "boolean",
											"const": true
										}
									},
									"required": [
										"npmpro_dns_challenge"
									]
								},
								"then": {
									"properties": {
										"domain_names": {
											"$ref": "../../../../components/certificate-object.json#/properties/domain_names_dns"
										}
									}
								},
								"else": {
									"properties": {
										"domain_names": {
											"$ref": "../../../../components/certificate-object.json#/properties/domain_names_http"
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"forward_scheme": {
										"const": "empty"
									}
								},
								"required": [
									"forward_scheme"
								]
							},
							"else": {
								"properties": {
									"forward_host": {
										"minLength": 1
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"npmpro_access_list_type": {
										"const": "custom"
									}
								},
								"required": [
									"npmpro_access_list_type"
								]
							},
							"then": {
								"properties": {
									"npmpro_access_list_ids": {
										"minItems": 1
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"npmpro_mtls_certificate_id": {
										"type": "integer",
										"minimum": 1
									},
									"npmpro_mtls_verify_client_optional": {
										"type": "boolean",
										"const": false
									}
								},
								"required": [
									"npmpro_mtls_certificate_id",
									"npmpro_mtls_verify_client_optional"
								]
							},
							"then": {
								"properties": {
									"ssl_forced": {
										"type": "boolean",
										"const": true
									}
								}
							}
						}
					],
					"minProperties": 1,
					"properties": {
						"domain_names": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/domain_names"
						},
						"forward_scheme": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/forward_scheme"
						},
						"forward_host": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/forward_host"
						},
						"forward_port": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/forward_port"
						},
						"certificate_id": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/certificate_id"
						},
						"ssl_forced": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/ssl_forced"
						},
						"hsts_enabled": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/hsts_enabled"
						},
						"hsts_subdomains": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/hsts_subdomains"
						},
						"npmpro_http3_support": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_http3_support"
						},
						"npmpro_noindex": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_noindex"
						},
						"npmpro_crowdsec_appsec": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_crowdsec_appsec"
						},
						"npmpro_proxy_request_buffering": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_proxy_request_buffering"
						},
						"npmpro_proxy_response_buffering": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_proxy_response_buffering"
						},
						"npmpro_upstream_compression": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_upstream_compression"
						},
						"npmpro_fancyindex": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_fancyindex"
						},
						"npmpro_x_frame_options": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_x_frame_options"
						},
						"npmpro_auth_request": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_auth_request"
						},
						"npmpro_auth_request_upstream": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_auth_request_upstream"
						},
						"npmpro_access_list_ids": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_access_list_ids"
						},
						"npmpro_access_list_type": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_access_list_type"
						},
						"advanced_config": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/advanced_config"
						},
						"npmpro_location_config": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_location_config"
						},
						"npmpro_directory": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_directory"
						},
						"npmpro_mtls_certificate_id": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_mtls_certificate_id"
						},
						"npmpro_mtls_verify_client_optional": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_mtls_verify_client_optional"
						},
						"npmpro_mtls_bypass_auth_request": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/npmpro_mtls_bypass_auth_request"
						},
						"npmpro_reuse_key": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_reuse_key"
						},
						"npmpro_dns_challenge": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_challenge"
						},
						"npmpro_dns_provider": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_provider"
						},
						"npmpro_dns_credential_id": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_credential_id"
						},
						"npmpro_propagation_seconds": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_propagation_seconds"
						},
						"locations": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/locations"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 3,
								"created_on": "2025-10-30T01:12:05.000Z",
								"modified_on": "2025-10-30T01:17:06.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"test.example.com"
								],
								"forward_host": "127.0.0.1",
								"forward_port": 8080,
								"npmpro_access_list_type": "public",
								"certificate_id": 0,
								"ssl_forced": false,
								"npmpro_noindex": false,
								"npmpro_crowdsec_appsec": false,
								"npmpro_proxy_request_buffering": false,
								"npmpro_proxy_response_buffering": false,
								"npmpro_upstream_compression": false,
								"npmpro_fancyindex": false,
								"npmpro_x_frame_options": "DENY",
								"npmpro_auth_request": "none",
								"npmpro_auth_request_upstream": "",
								"advanced_config": "",
								"npmpro_location_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_mtls_bypass_auth_request": false,
								"npmpro_http3_support": false,
								"forward_scheme": "http",
								"enabled": true,
								"locations": [],
								"hsts_enabled": false,
								"hsts_subdomains": false
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/proxy-host-object.json"
					}
				}
			}
		}
	}
}
