{
	"operationId": "getProxyHosts",
	"summary": "List proxy hosts",
	"tags": [
		"proxy-hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to each proxy host of the answer: one or several of `owner` (the user who created the host), `certificate` (its certificate), `access_lists` (proxy hosts always carry their access lists already) and `dns_records` (the states of the host record option as `npmpro_dns_records`, only for hosts that have it), separated by commas.",
			"schema": {
				"type": "string",
				"enum": [
					"access_lists",
					"owner",
					"certificate",
					"dns_records"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The proxy hosts, ordered by domain name",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 12,
									"created_on": "2026-11-17T09:30:00.000Z",
									"modified_on": "2026-11-17T09:30:00.000Z",
									"owner_user_id": 1,
									"domain_names": [
										"app.example.com"
									],
									"forward_host": "192.168.1.20",
									"forward_port": 8080,
									"npmpro_access_list_type": "custom",
									"certificate_id": 5,
									"ssl_forced": true,
									"npmpro_noindex": false,
									"npmpro_crowdsec_appsec": false,
									"npmpro_proxy_request_buffering": false,
									"npmpro_proxy_response_buffering": false,
									"npmpro_upstream_compression": false,
									"npmpro_fancyindex": false,
									"npmpro_x_frame_options": "SAMEORIGIN",
									"npmpro_auth_request": "none",
									"npmpro_auth_request_upstream": "",
									"advanced_config": "",
									"npmpro_location_config": "",
									"npmpro_nginx_online": true,
									"npmpro_nginx_err": "",
									"npmpro_directory": "",
									"npmpro_tags": [
										"Production"
									],
									"npmpro_description": "Internal app",
									"npmpro_mtls_certificate_id": 0,
									"npmpro_mtls_verify_client_optional": false,
									"npmpro_mtls_bypass_auth_request": false,
									"npmpro_http3_support": true,
									"forward_scheme": "http",
									"enabled": true,
									"locations": [],
									"hsts_enabled": true,
									"hsts_subdomains": false,
									"npmpro_maintenance": false,
									"npmpro_page_not_found": "upstream",
									"npmpro_page_upstream": "global",
									"npmpro_page_maintenance": "global",
									"access_lists": [
										{
											"id": 3,
											"created_on": "2026-11-17T09:30:00.000Z",
											"modified_on": "2026-11-17T09:30:00.000Z",
											"owner_user_id": 1,
											"name": "Office only",
											"satisfy_any": false,
											"pass_auth": false,
											"npmpro_denied_page": "global"
										}
									]
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../components/proxy-host-list.json"
					}
				}
			}
		}
	},
	"description": "Lists the proxy hosts, ordered by domain name. A user limited to their own items sees only theirs. The `query` query parameter searches domain names, descriptions and tags.\n\nNeeds: Proxy Hosts view"
}
