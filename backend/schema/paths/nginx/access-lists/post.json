{
	"operationId": "createAccessList",
	"summary": "Create an access list",
	"tags": [
		"access-lists"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"requestBody": {
		"description": "The access list: its name, how its checks combine, its users and its address rules",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"name"
					],
					"properties": {
						"name": {
							"$ref": "../../../components/access-list-object.json#/properties/name"
						},
						"satisfy_any": {
							"$ref": "../../../components/access-list-object.json#/properties/satisfy_any"
						},
						"pass_auth": {
							"$ref": "../../../components/access-list-object.json#/properties/pass_auth"
						},
						"items": {
							"$ref": "../../../common.json#/properties/access_items"
						},
						"clients": {
							"$ref": "../../../common.json#/properties/access_clients"
						},
						"npmpro_denied_page": {
							"$ref": "../../../components/access-list-object.json#/properties/npmpro_denied_page"
						},
						"npmpro_denied_page_html": {
							"$ref": "../../../components/access-list-object.json#/properties/npmpro_denied_page_html"
						},
						"npmpro_geo_mode": {
							"$ref": "../../../components/access-list-object.json#/properties/npmpro_geo_mode"
						},
						"npmpro_geo_unknown": {
							"$ref": "../../../components/access-list-object.json#/properties/npmpro_geo_unknown"
						},
						"npmpro_geo_drop": {
							"$ref": "../../../components/access-list-object.json#/properties/npmpro_geo_drop"
						},
						"npmpro_countries": {
							"$ref": "../../../components/access-list-object.json#/properties/npmpro_countries"
						}
					}
				},
				"example": {
					"name": "Office network",
					"satisfy_any": true,
					"pass_auth": false,
					"items": [
						{
							"username": "jane",
							"password": "your-password"
						}
					],
					"clients": [
						{
							"directive": "allow",
							"address": "198.51.100.0/24"
						},
						{
							"directive": "deny",
							"address": "all"
						}
					],
					"npmpro_denied_page": "global"
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "The created access list with its users and rules, without password hashes",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 3,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"name": "Office network",
								"satisfy_any": true,
								"pass_auth": false,
								"proxy_host_count": 0,
								"npmpro_denied_page": "global",
								"items": [
									{
										"id": 4,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"username": "jane"
									}
								],
								"clients": [
									{
										"id": 5,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"address": "198.51.100.0/24",
										"directive": "allow"
									},
									{
										"id": 6,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"address": "all",
										"directive": "deny"
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../components/access-list-object.json"
					}
				}
			}
		}
	},
	"description": "Creates an access list: basic auth users, address rules or both. Every user needs a password (at most 72 bytes), usernames must be unique, an `all` rule can only be the last rule, and the list needs at least one user, one rule that is not `all` or a country rule (a mode other than `off` with at least one country), otherwise the answer is 400. The password is stored only as a hash. The list protects nothing until a proxy host uses it.\n\nCountry rules: `npmpro_geo_mode` (`off`, `allow` or `deny`), `npmpro_countries` (ISO codes from NPMpro's list, each once, with an optional comment), `npmpro_geo_unknown` and `npmpro_geo_drop`. A mode other than `off` needs at least one country and a usable GeoIP country database (see GET /nginx/access-lists/geoip), otherwise the answer is 400. Every address rule and country can carry a comment.\n\nNeeds: Access Lists manage"
}
