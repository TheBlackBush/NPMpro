{
	"operationId": "getAccessList",
	"summary": "Get an access list",
	"tags": [
		"access-lists"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "listID",
			"description": "ID of the access list, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 3
		},
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to the answer: one or several of `items` (the basic auth users, without passwords), `clients` (the address rules) and `npmpro_countries` (the country rules), separated by commas. The schema also lists `proxy_hosts`, but the API refuses it here.",
			"schema": {
				"type": "string",
				"enum": [
					"items",
					"clients",
					"npmpro_countries",
					"proxy_hosts"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The access list",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 3,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"name": "Office network",
								"satisfy_any": true,
								"pass_auth": false,
								"proxy_host_count": 1,
								"npmpro_denied_page": "global",
								"items": [
									{
										"id": 4,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"username": "jane"
									}
								],
								"clients": [
									{
										"id": 5,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"address": "198.51.100.0/24",
										"directive": "allow"
									},
									{
										"id": 6,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"address": "all",
										"directive": "deny"
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/access-list-object.json"
					}
				}
			}
		}
	},
	"description": "Returns one access list. Without `expand` the answer has no users or rules. The answers never carry password hashes.\n\nNeeds: Access Lists view"
}
