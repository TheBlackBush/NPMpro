{
	"operationId": "updateAccessList",
	"summary": "Update an access list",
	"tags": [
		"access-lists"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "listID",
			"description": "ID of the access list, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 3
		}
	],
	"requestBody": {
		"description": "The fields to change",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"name": {
							"$ref": "../../../../components/access-list-object.json#/properties/name"
						},
						"satisfy_any": {
							"$ref": "../../../../components/access-list-object.json#/properties/satisfy_any"
						},
						"pass_auth": {
							"$ref": "../../../../components/access-list-object.json#/properties/pass_auth"
						},
						"items": {
							"$ref": "../../../../common.json#/properties/access_items"
						},
						"clients": {
							"$ref": "../../../../common.json#/properties/access_clients"
						},
						"npmpro_denied_page": {
							"$ref": "../../../../components/access-list-object.json#/properties/npmpro_denied_page"
						},
						"npmpro_denied_page_html": {
							"$ref": "../../../../components/access-list-object.json#/properties/npmpro_denied_page_html"
						}
					}
				},
				"example": {
					"name": "Office and home",
					"items": [
						{
							"username": "jane",
							"password": ""
						},
						{
							"username": "john",
							"password": "your-password"
						}
					],
					"clients": [
						{
							"directive": "allow",
							"address": "198.51.100.0/24"
						},
						{
							"directive": "allow",
							"address": "2001:db8::/32"
						},
						{
							"directive": "deny",
							"address": "all"
						}
					]
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The updated access list with its users and rules, without password hashes",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 3,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-18T08:00:00.000Z",
								"owner_user_id": 1,
								"name": "Office and home",
								"satisfy_any": true,
								"pass_auth": false,
								"proxy_host_count": 1,
								"npmpro_denied_page": "global",
								"items": [
									{
										"id": 4,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"username": "jane"
									},
									{
										"id": 7,
										"created_on": "2026-11-18T08:00:00.000Z",
										"modified_on": "2026-11-18T08:00:00.000Z",
										"access_list_id": 3,
										"username": "john"
									}
								],
								"clients": [
									{
										"id": 5,
										"created_on": "2026-11-17T09:30:00.000Z",
										"modified_on": "2026-11-17T09:30:00.000Z",
										"access_list_id": 3,
										"address": "198.51.100.0/24",
										"directive": "allow"
									},
									{
										"id": 8,
										"created_on": "2026-11-18T08:00:00.000Z",
										"modified_on": "2026-11-18T08:00:00.000Z",
										"access_list_id": 3,
										"address": "2001:db8::/32",
										"directive": "allow"
									},
									{
										"id": 9,
										"created_on": "2026-11-18T08:00:00.000Z",
										"modified_on": "2026-11-18T08:00:00.000Z",
										"access_list_id": 3,
										"address": "all",
										"directive": "deny"
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/access-list-object.json"
					}
				}
			}
		}
	},
	"description": "Changes an access list: send only what changes. `items` and `clients` replace the whole set: a user sent without a password keeps their password, a user left out is removed, a new user needs a password. The rules of the create operation apply. Saving rewrites the access file and the configs of the proxy hosts that use the list, and reloads nginx.\n\nNeeds: Access Lists manage"
}
