{
	"operationId": "getDnsCredentials",
	"summary": "List DNS credentials",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to each credential of the answer: any of `owner` (the user who created it), `certificates` (the certificates that use it) and `domains` (the names of its DNS domains), separated by commas.",
			"schema": {
				"type": "string",
				"enum": [
					"owner",
					"certificates",
					"domains"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The DNS credentials, ordered by name",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"created_on": "2026-11-17T09:30:00.000Z",
									"modified_on": "2026-11-17T09:30:00.000Z",
									"owner_user_id": 1,
									"name": "Cloudflare main",
									"provider": "cloudflare",
									"fields": [
										{
											"key": "dns_cloudflare_api_token",
											"is_set": true
										},
										{
											"key": "dns_cloudflare_email",
											"is_set": false
										},
										{
											"key": "dns_cloudflare_api_key",
											"is_set": false
										}
									],
									"ini_set": false,
									"decrypt_error": false,
									"domains": [
										"example.com"
									]
								},
								{
									"id": 2,
									"created_on": "2026-11-18T07:55:00.000Z",
									"modified_on": "2026-11-18T07:55:00.000Z",
									"owner_user_id": 1,
									"name": "Cloudflare spare",
									"provider": "cloudflare",
									"fields": [
										{
											"key": "dns_cloudflare_api_token",
											"is_set": true
										},
										{
											"key": "dns_cloudflare_email",
											"is_set": false
										},
										{
											"key": "dns_cloudflare_api_key",
											"is_set": false
										}
									],
									"ini_set": false,
									"decrypt_error": false,
									"domains": [
										"example.com"
									]
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../components/dns-credential-list.json"
					}
				}
			}
		}
	},
	"description": "Lists the saved DNS credentials, ordered by name. A user limited to their own items sees only theirs. The `query` query parameter searches the names. The answers show which fields are set, never the secret values or a raw credentials file.\n\nNeeds: Certificates view"
}
