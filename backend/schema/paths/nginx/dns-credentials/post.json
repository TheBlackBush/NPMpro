{
	"operationId": "createDnsCredential",
	"summary": "Create a DNS credential",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "DNS credential payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"name",
						"provider"
					],
					"properties": {
						"name": {
							"$ref": "../../../components/dns-credential-object.json#/properties/name"
						},
						"provider": {
							"$ref": "../../../components/dns-credential-object.json#/properties/provider"
						},
						"fields": {
							"type": "array",
							"description": "Secret values may be omitted or empty to keep the stored value",
							"items": {
								"type": "object",
								"required": [
									"key"
								],
								"additionalProperties": false,
								"properties": {
									"key": {
										"type": "string",
										"minLength": 1,
										"maxLength": 255
									},
									"value": {
										"type": "string",
										"maxLength": 4096
									}
								}
							}
						},
						"ini": {
							"$ref": "../../../components/dns-credential-object.json#/properties/ini"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2024-10-09T05:31:58.000Z",
								"modified_on": "2024-10-09T05:32:11.000Z",
								"owner_user_id": 1,
								"name": "Cloudflare main",
								"provider": "cloudflare",
								"fields": [
									{
										"key": "dns_cloudflare_api_token",
										"is_set": true
									}
								],
								"ini_set": false,
								"decrypt_error": false
							}
						}
					},
					"schema": {
						"$ref": "../../../components/dns-credential-object.json"
					}
				}
			}
		}
	}
}
