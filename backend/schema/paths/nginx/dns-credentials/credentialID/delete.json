{
	"operationId": "deleteDnsCredential",
	"summary": "Delete a DNS credential",
	"tags": [
		"DNS Credentials"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "credentialID",
			"description": "ID of the DNS credential, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The credential that was deleted, without its values",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 2,
								"created_on": "2026-11-18T07:55:00.000Z",
								"modified_on": "2026-11-18T07:55:00.000Z",
								"owner_user_id": 1,
								"name": "Cloudflare spare",
								"provider": "cloudflare",
								"fields": [
									{
										"key": "dns_cloudflare_api_token",
										"is_set": true
									},
									{
										"key": "dns_cloudflare_email",
										"is_set": false
									},
									{
										"key": "dns_cloudflare_api_key",
										"is_set": false
									}
								],
								"ini_set": false,
								"decrypt_error": false
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/dns-credential-object.json"
					}
				}
			}
		}
	},
	"description": "Deletes a DNS credential for good. A credential that certificates still use is refused with a 400; link those to another credential first. The answer is the credential as it was, without its values.\nNeeds: Certificates manage and the token's Allow delete switch"
}
