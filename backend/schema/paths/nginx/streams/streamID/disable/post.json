{
	"operationId": "disableStream",
	"summary": "Disable a stream",
	"tags": [
		"streams"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "streamID",
			"description": "ID of the stream, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The stream after it was disabled",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 3,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T10:15:00.000Z",
								"owner_user_id": 1,
								"incoming_port": "5432",
								"forwarding_host": "10.0.0.5",
								"forwarding_port": "5432",
								"tcp_forwarding": true,
								"udp_forwarding": false,
								"npmpro_proxy_protocol_forwarding": 0,
								"npmpro_proxy_tls": false,
								"npmpro_advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [
									"Production"
								],
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"enabled": false,
								"certificate_id": 0,
								"npmpro_description": "Database"
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/stream-object.json"
					}
				}
			}
		},
		"400": {
			"description": "The stream is already disabled",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Stream is already disabled"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error.json"
					}
				}
			}
		}
	},
	"description": "Turns a stream off: removes its nginx config and reloads nginx, keeping the stream stored. It is refused with a 400 when the stream is already disabled.\n\nNeeds: Streams manage"
}
