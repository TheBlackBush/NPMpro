{
	"operationId": "getStream",
	"summary": "Get a stream",
	"tags": [
		"Streams"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "streamID",
			"description": "ID of the stream, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 3
		}
	],
	"responses": {
		"200": {
			"description": "The stream",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 3,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"incoming_port": "5432",
								"forwarding_host": "10.0.0.5",
								"forwarding_port": "5432",
								"tcp_forwarding": true,
								"udp_forwarding": false,
								"npmpro_proxy_protocol_forwarding": 0,
								"npmpro_proxy_tls": false,
								"npmpro_advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [
									"Production"
								],
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"enabled": true,
								"certificate_id": 0,
								"npmpro_description": "Database"
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/stream-object.json"
					}
				}
			}
		}
	},
	"description": "Returns one stream. The answer carries no owner or certificate object; use the list with `expand` for those.\n\nNeeds: Streams view"
}
