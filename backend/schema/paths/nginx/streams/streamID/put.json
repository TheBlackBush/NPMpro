{
	"operationId": "updateStream",
	"summary": "Update a Stream",
	"tags": [
		"streams"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "streamID",
			"description": "The ID of the Stream",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"requestBody": {
		"description": "Stream Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"if": {
						"properties": {
							"certificate_id": {
								"const": "new"
							}
						},
						"required": [
							"certificate_id"
						]
					},
					"then": {
						"required": [
							"domain_names",
							"npmpro_dns_challenge",
							"npmpro_dns_provider",
							"npmpro_dns_credential_id"
						],
						"properties": {
							"npmpro_dns_challenge": {
								"type": "boolean",
								"const": true
							}
						}
					},
					"minProperties": 1,
					"properties": {
						"incoming_port": {
							"$ref": "../../../../components/stream-object.json#/properties/incoming_port"
						},
						"forwarding_host": {
							"$ref": "../../../../components/stream-object.json#/properties/forwarding_host"
						},
						"forwarding_port": {
							"$ref": "../../../../components/stream-object.json#/properties/forwarding_port"
						},
						"tcp_forwarding": {
							"$ref": "../../../../components/stream-object.json#/properties/tcp_forwarding"
						},
						"udp_forwarding": {
							"$ref": "../../../../components/stream-object.json#/properties/udp_forwarding"
						},
						"npmpro_proxy_protocol_forwarding": {
							"$ref": "../../../../components/stream-object.json#/properties/npmpro_proxy_protocol_forwarding"
						},
						"npmpro_proxy_tls": {
							"$ref": "../../../../components/stream-object.json#/properties/npmpro_proxy_tls"
						},
						"certificate_id": {
							"$ref": "../../../../components/stream-object.json#/properties/certificate_id"
						},
						"domain_names": {
							"$ref": "../../../../components/certificate-object.json#/properties/domain_names_dns"
						},
						"npmpro_reuse_key": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_reuse_key"
						},
						"npmpro_dns_challenge": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_challenge"
						},
						"npmpro_dns_provider": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_provider"
						},
						"npmpro_dns_credential_id": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_credential_id"
						},
						"npmpro_propagation_seconds": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_propagation_seconds"
						},
						"npmpro_advanced_config": {
							"$ref": "../../../../components/stream-object.json#/properties/npmpro_advanced_config"
						},
						"npmpro_directory": {
							"$ref": "../../../../components/stream-object.json#/properties/npmpro_directory"
						},
						"npmpro_mtls_certificate_id": {
							"$ref": "../../../../components/stream-object.json#/properties/npmpro_mtls_certificate_id"
						},
						"npmpro_mtls_verify_client_optional": {
							"$ref": "../../../../components/stream-object.json#/properties/npmpro_mtls_verify_client_optional"
						},
						"npmpro_description": {
							"$ref": "../../../../components/stream-object.json#/properties/npmpro_description"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2024-10-09T02:33:45.000Z",
								"modified_on": "2024-10-09T02:33:45.000Z",
								"owner_user_id": 1,
								"incoming_port": 9090,
								"forwarding_host": "router.internal",
								"forwarding_port": 80,
								"tcp_forwarding": true,
								"udp_forwarding": false,
								"npmpro_proxy_protocol_forwarding": 0,
								"npmpro_proxy_tls": false,
								"npmpro_advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"enabled": true,
								"certificate_id": 0
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/stream-object.json"
					}
				}
			}
		}
	}
}
