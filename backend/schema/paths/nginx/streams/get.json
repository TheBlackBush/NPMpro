{
	"operationId": "getStreams",
	"summary": "List streams",
	"tags": [
		"Streams"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to each stream of the answer: one or several of `owner` (the user who created the stream) and `certificate` (its certificate), separated by commas.",
			"schema": {
				"type": "string",
				"enum": [
					"owner",
					"certificate"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The streams, ordered by incoming port",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 3,
									"created_on": "2026-11-17T09:30:00.000Z",
									"modified_on": "2026-11-17T09:30:00.000Z",
									"owner_user_id": 1,
									"incoming_port": "5432",
									"forwarding_host": "10.0.0.5",
									"forwarding_port": "5432",
									"tcp_forwarding": true,
									"udp_forwarding": false,
									"npmpro_proxy_protocol_forwarding": 0,
									"npmpro_proxy_tls": false,
									"npmpro_advanced_config": "",
									"npmpro_nginx_online": true,
									"npmpro_nginx_err": "",
									"npmpro_directory": "",
									"npmpro_tags": [
										"Production"
									],
									"npmpro_mtls_certificate_id": 0,
									"npmpro_mtls_verify_client_optional": false,
									"enabled": true,
									"certificate_id": 0,
									"npmpro_description": "Database"
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../components/stream-list.json"
					}
				}
			}
		}
	},
	"description": "Lists the streams, ordered by incoming port. A user limited to their own items sees only theirs. The `query` query parameter searches incoming ports, forwarding ports and hosts, descriptions and tags.\nNeeds: Streams view"
}
