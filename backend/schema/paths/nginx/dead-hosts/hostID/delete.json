{
	"operationId": "deleteDeadHost",
	"summary": "Delete a 404 host",
	"tags": [
		"404-hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "ID of the 404 host, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 4
		}
	],
	"responses": {
		"200": {
			"description": "The 404 host that was deleted",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 4,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"old.example.com"
								],
								"certificate_id": 5,
								"ssl_forced": true,
								"advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [],
								"npmpro_description": "Retired site",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_http3_support": false,
								"enabled": true,
								"hsts_enabled": false,
								"hsts_subdomains": false,
								"npmpro_page": "global"
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/dead-host-object.json"
					}
				}
			}
		}
	},
	"description": "Deletes a 404 host for good, removes its nginx config and reloads nginx. The answer is the 404 host as it was.\n\nNeeds: 404 Hosts manage and the token's Allow delete switch"
}
