{
	"operationId": "disableDeadHost",
	"summary": "Disable a 404 host",
	"tags": [
		"404 Hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "ID of the 404 host, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The 404 host after it was disabled",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 4,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T10:15:00.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"old.example.com"
								],
								"certificate_id": 5,
								"ssl_forced": true,
								"advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [],
								"npmpro_description": "Retired site",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_http3_support": false,
								"enabled": false,
								"hsts_enabled": false,
								"hsts_subdomains": false,
								"npmpro_page": "global"
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/dead-host-object.json"
					}
				}
			}
		},
		"400": {
			"description": "The 404 host is already disabled",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Host is already disabled"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error.json"
					}
				}
			}
		}
	},
	"description": "Turns a 404 host off: removes its nginx config and reloads nginx, keeping the 404 host stored. It is refused with a 400 when the 404 host is already disabled.\nNeeds: 404 Hosts manage"
}
