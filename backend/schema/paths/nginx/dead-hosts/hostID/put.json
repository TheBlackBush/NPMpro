{
	"operationId": "updateDeadHost",
	"summary": "Update a 404 host",
	"tags": [
		"404 Hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "ID of the 404 host, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 4
		}
	],
	"requestBody": {
		"description": "404 Host fields",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"allOf": [
						{
							"if": {
								"properties": {
									"npmpro_dns_challenge": {
										"type": "boolean",
										"const": true
									}
								},
								"required": [
									"npmpro_dns_challenge"
								]
							},
							"then": {
								"required": [
									"npmpro_dns_provider",
									"npmpro_dns_credential_id"
								]
							}
						},
						{
							"if": {
								"properties": {
									"certificate_id": {
										"const": "new"
									}
								},
								"required": [
									"certificate_id"
								]
							},
							"then": {
								"if": {
									"properties": {
										"npmpro_dns_challenge": {
											"type": "boolean",
											"const": true
										}
									},
									"required": [
										"npmpro_dns_challenge"
									]
								},
								"then": {
									"properties": {
										"domain_names": {
											"$ref": "../../../../components/certificate-object.json#/properties/domain_names_dns"
										}
									}
								},
								"else": {
									"properties": {
										"domain_names": {
											"$ref": "../../../../components/certificate-object.json#/properties/domain_names_http"
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"npmpro_mtls_certificate_id": {
										"type": "integer",
										"minimum": 1
									},
									"npmpro_mtls_verify_client_optional": {
										"type": "boolean",
										"const": false
									}
								},
								"required": [
									"npmpro_mtls_certificate_id",
									"npmpro_mtls_verify_client_optional"
								]
							},
							"then": {
								"properties": {
									"ssl_forced": {
										"type": "boolean",
										"const": true
									}
								}
							}
						}
					],
					"minProperties": 1,
					"properties": {
						"domain_names": {
							"$ref": "../../../../components/dead-host-object.json#/properties/domain_names"
						},
						"certificate_id": {
							"$ref": "../../../../components/dead-host-object.json#/properties/certificate_id"
						},
						"ssl_forced": {
							"$ref": "../../../../components/dead-host-object.json#/properties/ssl_forced"
						},
						"hsts_enabled": {
							"$ref": "../../../../components/dead-host-object.json#/properties/hsts_enabled"
						},
						"hsts_subdomains": {
							"$ref": "../../../../components/dead-host-object.json#/properties/hsts_subdomains"
						},
						"npmpro_http3_support": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_http3_support"
						},
						"advanced_config": {
							"$ref": "../../../../components/dead-host-object.json#/properties/advanced_config"
						},
						"npmpro_directory": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_directory"
						},
						"npmpro_description": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_description"
						},
						"npmpro_tags": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_tags"
						},
						"npmpro_mtls_certificate_id": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_mtls_certificate_id"
						},
						"npmpro_mtls_verify_client_optional": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_mtls_verify_client_optional"
						},
						"npmpro_reuse_key": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_reuse_key"
						},
						"npmpro_dns_challenge": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_challenge"
						},
						"npmpro_dns_provider": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_provider"
						},
						"npmpro_dns_credential_id": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_credential_id"
						},
						"npmpro_propagation_seconds": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_propagation_seconds"
						},
						"npmpro_page": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_page"
						},
						"npmpro_page_html": {
							"$ref": "../../../../components/dead-host-object.json#/properties/npmpro_page_html"
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"npmpro_page": "npmpro",
							"npmpro_description": "Retired site, built-in page"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The updated 404 host",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 4,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T10:15:00.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"old.example.com"
								],
								"certificate_id": 5,
								"ssl_forced": true,
								"advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [],
								"npmpro_description": "Retired site, built-in page",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_http3_support": false,
								"enabled": true,
								"hsts_enabled": false,
								"hsts_subdomains": false,
								"npmpro_page": "npmpro"
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/dead-host-object.json"
					}
				}
			}
		}
	},
	"description": "Changes a 404 host: send only the fields to change. When the host is enabled it rewrites the nginx config and reloads nginx like a create (a disabled host is only saved, nothing is written or reloaded), and `certificate_id` `new` requests a certificate the same way. A config nginx refuses is still stored: the answer then has `npmpro_nginx_online` false and the nginx message in `npmpro_nginx_err`, and the config stays out of nginx until it is fixed.\n\nNeeds: 404 Hosts manage"
}
