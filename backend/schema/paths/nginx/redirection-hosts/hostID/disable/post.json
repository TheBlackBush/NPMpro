{
	"operationId": "disableRedirectionHost",
	"summary": "Disable a redirection host",
	"tags": [
		"Redirection Hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "ID of the redirection host, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The redirection host after it was disabled",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 8,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T10:15:00.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"www.example.com"
								],
								"forward_domain_name": "app.example.com",
								"preserve_path": true,
								"certificate_id": 5,
								"ssl_forced": true,
								"advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [],
								"npmpro_description": "Old www address",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_http3_support": false,
								"enabled": false,
								"hsts_enabled": true,
								"hsts_subdomains": false,
								"forward_scheme": "https",
								"forward_http_code": 301
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/redirection-host-object.json"
					}
				}
			}
		},
		"400": {
			"description": "The redirection host is already disabled",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Host is already disabled"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/error.json"
					}
				}
			}
		}
	},
	"description": "Turns a redirection host off: removes its nginx config and reloads nginx, keeping the redirection host stored. It is refused with a 400 when the redirection host is already disabled.\nNeeds: Redirection Hosts manage"
}
