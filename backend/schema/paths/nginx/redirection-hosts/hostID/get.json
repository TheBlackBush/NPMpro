{
	"operationId": "getRedirectionHost",
	"summary": "Get a redirection host",
	"tags": [
		"Redirection Hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "ID of the redirection host, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 8
		}
	],
	"responses": {
		"200": {
			"description": "The redirection host",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 8,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"www.example.com"
								],
								"forward_domain_name": "app.example.com",
								"preserve_path": true,
								"certificate_id": 5,
								"ssl_forced": true,
								"advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [],
								"npmpro_description": "Old www address",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_http3_support": false,
								"enabled": true,
								"hsts_enabled": true,
								"hsts_subdomains": false,
								"forward_scheme": "https",
								"forward_http_code": 301
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/redirection-host-object.json"
					}
				}
			}
		}
	},
	"description": "Returns one redirection host. The answer carries no owner or certificate object; use the list with `expand` for those.\n\nNeeds: Redirection Hosts view"
}
