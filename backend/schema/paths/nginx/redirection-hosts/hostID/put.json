{
	"operationId": "updateRedirectionHost",
	"summary": "Update a Redirection Host",
	"tags": [
		"redirection-hosts"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "The ID of the Redirection Host",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"requestBody": {
		"description": "Redirection Host       Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"allOf": [
						{
							"if": {
								"properties": {
									"npmpro_dns_challenge": {
										"type": "boolean",
										"const": true
									}
								},
								"required": [
									"npmpro_dns_challenge"
								]
							},
							"then": {
								"required": [
									"npmpro_dns_provider",
									"npmpro_dns_credential_id"
								]
							}
						},
						{
							"if": {
								"properties": {
									"certificate_id": {
										"const": "new"
									}
								},
								"required": [
									"certificate_id"
								]
							},
							"then": {
								"if": {
									"properties": {
										"npmpro_dns_challenge": {
											"type": "boolean",
											"const": true
										}
									},
									"required": [
										"npmpro_dns_challenge"
									]
								},
								"then": {
									"properties": {
										"domain_names": {
											"$ref": "../../../../components/certificate-object.json#/properties/domain_names_dns"
										}
									}
								},
								"else": {
									"properties": {
										"domain_names": {
											"$ref": "../../../../components/certificate-object.json#/properties/domain_names_http"
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"npmpro_mtls_certificate_id": {
										"type": "integer",
										"minimum": 1
									},
									"npmpro_mtls_verify_client_optional": {
										"type": "boolean",
										"const": false
									}
								},
								"required": [
									"npmpro_mtls_certificate_id",
									"npmpro_mtls_verify_client_optional"
								]
							},
							"then": {
								"properties": {
									"ssl_forced": {
										"type": "boolean",
										"const": true
									}
								}
							}
						}
					],
					"minProperties": 1,
					"properties": {
						"domain_names": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/domain_names"
						},
						"forward_http_code": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/forward_http_code"
						},
						"forward_scheme": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/forward_scheme"
						},
						"forward_domain_name": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/forward_domain_name"
						},
						"preserve_path": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/preserve_path"
						},
						"certificate_id": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/certificate_id"
						},
						"ssl_forced": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/ssl_forced"
						},
						"hsts_enabled": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/hsts_enabled"
						},
						"hsts_subdomains": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/hsts_subdomains"
						},
						"npmpro_http3_support": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/npmpro_http3_support"
						},
						"advanced_config": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/advanced_config"
						},
						"npmpro_directory": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/npmpro_directory"
						},
						"npmpro_mtls_certificate_id": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/npmpro_mtls_certificate_id"
						},
						"npmpro_mtls_verify_client_optional": {
							"$ref": "../../../../components/redirection-host-object.json#/properties/npmpro_mtls_verify_client_optional"
						},
						"npmpro_reuse_key": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_reuse_key"
						},
						"npmpro_dns_challenge": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_challenge"
						},
						"npmpro_dns_provider": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_provider"
						},
						"npmpro_dns_credential_id": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_dns_credential_id"
						},
						"npmpro_propagation_seconds": {
							"$ref": "../../../../components/certificate-object.json#/properties/npmpro_propagation_seconds"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2024-10-09T01:13:12.000Z",
								"modified_on": "2024-10-09T01:18:11.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"test.example.com"
								],
								"forward_domain_name": "something-else.com",
								"preserve_path": false,
								"certificate_id": 0,
								"ssl_forced": false,
								"advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_http3_support": false,
								"enabled": true,
								"hsts_enabled": false,
								"hsts_subdomains": false,
								"forward_scheme": "http",
								"forward_http_code": 301
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/redirection-host-object.json"
					}
				}
			}
		}
	}
}
