{
	"operationId": "createRedirectionHost",
	"summary": "Create a redirection host",
	"tags": [
		"redirection-hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"requestBody": {
		"description": "Redirection Host fields",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"allOf": [
						{
							"if": {
								"properties": {
									"npmpro_dns_challenge": {
										"type": "boolean",
										"const": true
									}
								},
								"required": [
									"npmpro_dns_challenge"
								]
							},
							"then": {
								"required": [
									"npmpro_dns_provider",
									"npmpro_dns_credential_id"
								]
							}
						},
						{
							"if": {
								"properties": {
									"certificate_id": {
										"const": "new"
									}
								},
								"required": [
									"certificate_id"
								]
							},
							"then": {
								"if": {
									"properties": {
										"npmpro_dns_challenge": {
											"type": "boolean",
											"const": true
										}
									},
									"required": [
										"npmpro_dns_challenge"
									]
								},
								"then": {
									"properties": {
										"domain_names": {
											"$ref": "../../../components/certificate-object.json#/properties/domain_names_dns"
										}
									}
								},
								"else": {
									"properties": {
										"domain_names": {
											"$ref": "../../../components/certificate-object.json#/properties/domain_names_http"
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"npmpro_mtls_certificate_id": {
										"type": "integer",
										"minimum": 1
									},
									"npmpro_mtls_verify_client_optional": {
										"type": "boolean",
										"const": false
									}
								},
								"required": [
									"npmpro_mtls_certificate_id"
								]
							},
							"then": {
								"properties": {
									"ssl_forced": {
										"type": "boolean",
										"const": true
									}
								}
							}
						}
					],
					"required": [
						"domain_names",
						"forward_domain_name"
					],
					"properties": {
						"domain_names": {
							"$ref": "../../../components/redirection-host-object.json#/properties/domain_names"
						},
						"forward_http_code": {
							"$ref": "../../../components/redirection-host-object.json#/properties/forward_http_code"
						},
						"forward_scheme": {
							"$ref": "../../../components/redirection-host-object.json#/properties/forward_scheme"
						},
						"forward_domain_name": {
							"$ref": "../../../components/redirection-host-object.json#/properties/forward_domain_name"
						},
						"preserve_path": {
							"$ref": "../../../components/redirection-host-object.json#/properties/preserve_path"
						},
						"certificate_id": {
							"$ref": "../../../components/redirection-host-object.json#/properties/certificate_id"
						},
						"ssl_forced": {
							"$ref": "../../../components/redirection-host-object.json#/properties/ssl_forced"
						},
						"hsts_enabled": {
							"$ref": "../../../components/redirection-host-object.json#/properties/hsts_enabled"
						},
						"hsts_subdomains": {
							"$ref": "../../../components/redirection-host-object.json#/properties/hsts_subdomains"
						},
						"npmpro_http3_support": {
							"$ref": "../../../components/redirection-host-object.json#/properties/npmpro_http3_support"
						},
						"advanced_config": {
							"$ref": "../../../components/redirection-host-object.json#/properties/advanced_config"
						},
						"npmpro_directory": {
							"$ref": "../../../components/redirection-host-object.json#/properties/npmpro_directory"
						},
						"npmpro_description": {
							"$ref": "../../../components/redirection-host-object.json#/properties/npmpro_description"
						},
						"npmpro_tags": {
							"$ref": "../../../components/redirection-host-object.json#/properties/npmpro_tags"
						},
						"npmpro_mtls_certificate_id": {
							"$ref": "../../../components/redirection-host-object.json#/properties/npmpro_mtls_certificate_id"
						},
						"npmpro_mtls_verify_client_optional": {
							"$ref": "../../../components/redirection-host-object.json#/properties/npmpro_mtls_verify_client_optional"
						},
						"npmpro_reuse_key": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_reuse_key"
						},
						"npmpro_dns_challenge": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_challenge"
						},
						"npmpro_dns_provider": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_provider"
						},
						"npmpro_dns_credential_id": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_credential_id"
						},
						"npmpro_propagation_seconds": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_propagation_seconds"
						}
					}
				},
				"examples": {
					"default": {
						"summary": "With an existing certificate",
						"value": {
							"domain_names": [
								"www.example.com"
							],
							"forward_domain_name": "app.example.com",
							"forward_scheme": "https",
							"forward_http_code": 301,
							"preserve_path": true,
							"certificate_id": 5,
							"ssl_forced": true,
							"hsts_enabled": true,
							"npmpro_description": "Old www address"
						}
					},
					"newCertificate": {
						"summary": "Requesting a new certificate",
						"value": {
							"domain_names": [
								"www.example.com"
							],
							"forward_domain_name": "app.example.com",
							"forward_scheme": "https",
							"forward_http_code": 301,
							"certificate_id": "new",
							"ssl_forced": true
						}
					}
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "The created redirection host",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 8,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"domain_names": [
									"www.example.com"
								],
								"forward_domain_name": "app.example.com",
								"preserve_path": true,
								"certificate_id": 5,
								"ssl_forced": true,
								"advanced_config": "",
								"npmpro_nginx_online": true,
								"npmpro_nginx_err": "",
								"npmpro_directory": "",
								"npmpro_tags": [],
								"npmpro_description": "Old www address",
								"npmpro_mtls_certificate_id": 0,
								"npmpro_mtls_verify_client_optional": false,
								"npmpro_http3_support": false,
								"enabled": true,
								"hsts_enabled": true,
								"hsts_subdomains": false,
								"forward_scheme": "https",
								"forward_http_code": 301
							}
						}
					},
					"schema": {
						"$ref": "../../../components/redirection-host-object.json"
					}
				}
			}
		}
	},
	"description": "Creates a redirection host, writes its nginx config and reloads nginx. A domain name already used by another enabled host is refused with a 400. Set `certificate_id` to `new` to request a Let's Encrypt certificate for the domain names in the same call (HTTP challenge, or the DNS challenge fields; it also needs Certificates manage). A config nginx refuses is still stored: the answer then has `npmpro_nginx_online` false and the nginx message in `npmpro_nginx_err`, and the config stays out of nginx until it is fixed.\n\nNeeds: Redirection Hosts manage"
}
