{
	"operationId": "getRedirectionHosts",
	"summary": "List redirection hosts",
	"tags": [
		"Redirection Hosts"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to each redirection host of the answer: one or several of `owner` (the user who created the host) and `certificate` (its certificate), separated by commas.",
			"schema": {
				"type": "string",
				"enum": [
					"owner",
					"certificate"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The redirection hosts, ordered by domain name",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 8,
									"created_on": "2026-11-17T09:30:00.000Z",
									"modified_on": "2026-11-17T09:30:00.000Z",
									"owner_user_id": 1,
									"domain_names": [
										"www.example.com"
									],
									"forward_domain_name": "app.example.com",
									"preserve_path": true,
									"certificate_id": 5,
									"ssl_forced": true,
									"advanced_config": "",
									"npmpro_nginx_online": true,
									"npmpro_nginx_err": "",
									"npmpro_directory": "",
									"npmpro_tags": [],
									"npmpro_description": "Old www address",
									"npmpro_mtls_certificate_id": 0,
									"npmpro_mtls_verify_client_optional": false,
									"npmpro_http3_support": false,
									"enabled": true,
									"hsts_enabled": true,
									"hsts_subdomains": false,
									"forward_scheme": "https",
									"forward_http_code": 301
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../components/redirection-host-list.json"
					}
				}
			}
		}
	},
	"description": "Lists the redirection hosts, ordered by domain name. A user limited to their own items sees only theirs. The `query` query parameter searches domain names, descriptions and tags.\nNeeds: Redirection Hosts view"
}
