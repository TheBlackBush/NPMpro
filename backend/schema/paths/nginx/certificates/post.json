{
	"operationId": "createCertificate",
	"summary": "Create a certificate",
	"tags": [
		"Certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"requestBody": {
		"description": "The certificate to create: a Let's Encrypt certificate (HTTP or DNS challenge), or the name of a custom or mTLS certificate whose files come later",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"provider"
					],
					"allOf": [
						{
							"if": {
								"properties": {
									"provider": {
										"const": "letsencrypt"
									}
								}
							},
							"then": {
								"required": [
									"domain_names"
								]
							},
							"else": {
								"properties": {
									"domain_names": false
								}
							}
						},
						{
							"if": {
								"properties": {
									"npmpro_dns_challenge": {
										"type": "boolean",
										"const": true
									}
								},
								"required": [
									"npmpro_dns_challenge"
								]
							},
							"then": {
								"required": [
									"npmpro_dns_provider",
									"npmpro_dns_credential_id"
								],
								"properties": {
									"domain_names": {
										"$ref": "../../../components/certificate-object.json#/properties/domain_names_dns"
									}
								}
							},
							"else": {
								"if": {
									"properties": {
										"provider": {
											"const": "letsencrypt"
										}
									}
								},
								"then": {
									"properties": {
										"domain_names": {
											"$ref": "../../../components/certificate-object.json#/properties/domain_names_http"
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"provider": {
										"enum": [
											"other",
											"mtls"
										]
									}
								},
								"required": [
									"provider"
								]
							},
							"then": {
								"required": [
									"nice_name"
								],
								"properties": {
									"nice_name": {
										"minLength": 1
									}
								}
							}
						}
					],
					"properties": {
						"provider": {
							"$ref": "../../../components/certificate-object.json#/properties/provider"
						},
						"nice_name": {
							"$ref": "../../../components/certificate-object.json#/properties/nice_name"
						},
						"domain_names": {
							"$ref": "../../../components/certificate-object.json#/properties/domain_names"
						},
						"npmpro_reuse_key": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_reuse_key"
						},
						"npmpro_dns_challenge": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_challenge"
						},
						"npmpro_dns_provider": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_provider"
						},
						"npmpro_dns_credential_id": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_credential_id"
						},
						"npmpro_propagation_seconds": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_propagation_seconds"
						}
					}
				},
				"examples": {
					"letsencrypt-http": {
						"summary": "Let's Encrypt with the HTTP challenge",
						"value": {
							"provider": "letsencrypt",
							"domain_names": [
								"app.example.com"
							]
						}
					},
					"letsencrypt-dns": {
						"summary": "Let's Encrypt with a saved DNS credential",
						"value": {
							"provider": "letsencrypt",
							"domain_names": [
								"*.example.com",
								"example.com"
							],
							"npmpro_dns_challenge": true,
							"npmpro_dns_provider": "cloudflare",
							"npmpro_dns_credential_id": 1,
							"npmpro_propagation_seconds": 60
						}
					},
					"custom": {
						"summary": "A custom certificate, uploaded next",
						"value": {
							"provider": "other",
							"nice_name": "Internal wildcard"
						}
					}
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "The created certificate. A custom or mTLS certificate comes back with no domain names and its creation time as expiry until its files are uploaded",
			"content": {
				"application/json": {
					"examples": {
						"letsencrypt-http": {
							"summary": "Let's Encrypt with the HTTP challenge",
							"value": {
								"id": 5,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"provider": "letsencrypt",
								"nice_name": "app.example.com",
								"domain_names": [
									"app.example.com"
								],
								"expires_on": "2027-02-15T09:30:00.000Z",
								"npmpro_reuse_key": false,
								"npmpro_dns_challenge": false,
								"npmpro_dns_provider": "",
								"npmpro_dns_credential_id": null,
								"npmpro_propagation_seconds": 0
							}
						},
						"letsencrypt-dns": {
							"summary": "Let's Encrypt with a saved DNS credential",
							"value": {
								"id": 6,
								"created_on": "2026-11-17T09:35:00.000Z",
								"modified_on": "2026-11-17T09:35:00.000Z",
								"owner_user_id": 1,
								"provider": "letsencrypt",
								"nice_name": "*.example.com, example.com",
								"domain_names": [
									"*.example.com",
									"example.com"
								],
								"expires_on": "2027-02-15T09:35:00.000Z",
								"npmpro_reuse_key": false,
								"npmpro_dns_challenge": true,
								"npmpro_dns_provider": "cloudflare",
								"npmpro_dns_credential_id": 1,
								"npmpro_propagation_seconds": 60
							}
						}
					},
					"schema": {
						"$ref": "../../../components/certificate-object.json"
					}
				}
			}
		},
		"400": {
			"description": "The request is refused: a domain or field is invalid, the DNS credential belongs to another provider, or the ACME server refused the request",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Domains are invalid"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../components/error.json"
					}
				}
			}
		}
	},
	"description": "Creates a certificate. With `provider` `letsencrypt` NPMpro requests it from the ACME server before it answers, which can take minutes: with the HTTP challenge (the default) the domains must reach this instance on port 80, with `npmpro_dns_challenge` it needs a saved DNS credential of the same provider (wildcards are allowed then). A request that fails leaves no certificate behind and answers 400. With `provider` `other` or `mtls` only the row is created: send the files to its upload operation next.\n\nNeeds: Certificates manage"
}
