{
	"operationId": "createCertificate",
	"summary": "Create a Certificate",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "Certificate Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"provider"
					],
					"allOf": [
						{
							"if": {
								"properties": {
									"provider": {
										"const": "letsencrypt"
									}
								}
							},
							"then": {
								"required": [
									"domain_names"
								]
							},
							"else": {
								"properties": {
									"domain_names": false
								}
							}
						},
						{
							"if": {
								"properties": {
									"npmpro_dns_challenge": {
										"type": "boolean",
										"const": true
									}
								},
								"required": [
									"npmpro_dns_challenge"
								]
							},
							"then": {
								"required": [
									"npmpro_dns_provider",
									"npmpro_dns_credential_id"
								],
								"properties": {
									"domain_names": {
										"$ref": "../../../components/certificate-object.json#/properties/domain_names_dns"
									}
								}
							},
							"else": {
								"if": {
									"properties": {
										"provider": {
											"const": "letsencrypt"
										}
									}
								},
								"then": {
									"properties": {
										"domain_names": {
											"$ref": "../../../components/certificate-object.json#/properties/domain_names_http"
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"provider": {
										"enum": [
											"other",
											"mtls"
										]
									}
								},
								"required": [
									"provider"
								]
							},
							"then": {
								"required": [
									"nice_name"
								],
								"properties": {
									"nice_name": {
										"minLength": 1
									}
								}
							}
						}
					],
					"properties": {
						"provider": {
							"$ref": "../../../components/certificate-object.json#/properties/provider"
						},
						"nice_name": {
							"$ref": "../../../components/certificate-object.json#/properties/nice_name"
						},
						"domain_names": {
							"$ref": "../../../components/certificate-object.json#/properties/domain_names"
						},
						"npmpro_reuse_key": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_reuse_key"
						},
						"npmpro_dns_challenge": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_challenge"
						},
						"npmpro_dns_provider": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_provider"
						},
						"npmpro_dns_credential_id": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_dns_credential_id"
						},
						"npmpro_propagation_seconds": {
							"$ref": "../../../components/certificate-object.json#/properties/npmpro_propagation_seconds"
						}
					}
				},
				"example": {
					"provider": "letsencrypt",
					"domain_names": [
						"test.example.com"
					]
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "201 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"expires_on": "2025-01-07 04:30:17",
								"modified_on": "2024-10-09 05:28:51",
								"id": 5,
								"created_on": "2024-10-09 05:28:35",
								"owner_user_id": 1,
								"provider": "letsencrypt",
								"nice_name": "test.example.com",
								"domain_names": [
									"test.example.com"
								],
								"npmpro_reuse_key": false,
								"npmpro_dns_challenge": false,
								"npmpro_dns_provider": "",
								"npmpro_propagation_seconds": 0
							}
						}
					},
					"schema": {
						"$ref": "../../../components/certificate-object.json"
					}
				}
			}
		},
		"400": {
			"description": "400 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Domains are invalid"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../components/error.json"
					}
				}
			}
		}
	}
}
