{
	"operationId": "getCertificates",
	"summary": "List certificates",
	"tags": [
		"Certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to each certificate of the answer: one or several of `owner` (the user who created it), `proxy_hosts`, `redirection_hosts`, `dead_hosts` and `streams` (the hosts using it as their certificate) and `mtls_proxy_hosts`, `mtls_redirection_hosts`, `mtls_dead_hosts` and `mtls_streams` (the hosts using it as their client CA), separated by commas.",
			"schema": {
				"type": "string",
				"enum": [
					"owner",
					"proxy_hosts",
					"redirection_hosts",
					"dead_hosts",
					"streams",
					"mtls_proxy_hosts",
					"mtls_redirection_hosts",
					"mtls_dead_hosts",
					"mtls_streams"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The certificates, ordered by name",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 6,
									"created_on": "2026-11-17T09:35:00.000Z",
									"modified_on": "2026-11-17T09:35:00.000Z",
									"owner_user_id": 1,
									"provider": "letsencrypt",
									"nice_name": "*.example.com, example.com",
									"domain_names": [
										"*.example.com",
										"example.com"
									],
									"expires_on": "2027-02-15T09:35:00.000Z",
									"npmpro_reuse_key": false,
									"npmpro_dns_challenge": true,
									"npmpro_dns_provider": "cloudflare",
									"npmpro_dns_credential_id": 1,
									"npmpro_propagation_seconds": 60
								},
								{
									"id": 7,
									"created_on": "2026-11-17T10:00:00.000Z",
									"modified_on": "2026-11-17T10:05:00.000Z",
									"owner_user_id": 1,
									"provider": "other",
									"nice_name": "Internal wildcard",
									"domain_names": [
										"*.example.com"
									],
									"expires_on": "2027-11-17T10:00:00.000Z",
									"npmpro_reuse_key": false,
									"npmpro_dns_challenge": false,
									"npmpro_dns_provider": "",
									"npmpro_dns_credential_id": null,
									"npmpro_propagation_seconds": 0
								},
								{
									"id": 5,
									"created_on": "2026-11-17T09:30:00.000Z",
									"modified_on": "2026-11-17T09:30:00.000Z",
									"owner_user_id": 1,
									"provider": "letsencrypt",
									"nice_name": "app.example.com",
									"domain_names": [
										"app.example.com"
									],
									"expires_on": "2027-02-15T09:30:00.000Z",
									"npmpro_reuse_key": false,
									"npmpro_dns_challenge": false,
									"npmpro_dns_provider": "",
									"npmpro_dns_credential_id": null,
									"npmpro_propagation_seconds": 0
								}
							]
						}
					},
					"schema": {
						"$ref": "../../../components/certificate-list.json"
					}
				}
			}
		}
	},
	"description": "Lists the certificates, ordered by name. A user limited to their own items sees only theirs. The `query` query parameter searches the names.\n\nNeeds: Certificates view"
}
