{
	"operationId": "setCertificateDnsCredential",
	"summary": "Links another saved DNS credential to a Certificate",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "certID",
			"description": "Certificate ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"requestBody": {
		"description": "DNS credential to use from the next renewal on",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"npmplus_dns_credential_id"
					],
					"properties": {
						"npmplus_dns_credential_id": {
							"type": "integer",
							"minimum": 1,
							"example": 1
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../../components/certificate-object.json"
					}
				}
			}
		}
	}
}
