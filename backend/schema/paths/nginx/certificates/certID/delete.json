{
	"operationId": "deleteCertificate",
	"summary": "Delete a certificate",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "certID",
			"description": "ID of the certificate, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 7
		}
	],
	"responses": {
		"200": {
			"description": "The certificate that was deleted",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 7,
								"created_on": "2026-11-17T10:00:00.000Z",
								"modified_on": "2026-11-17T10:05:00.000Z",
								"owner_user_id": 1,
								"provider": "other",
								"nice_name": "Internal wildcard",
								"domain_names": [
									"*.example.com"
								],
								"expires_on": "2027-11-17T10:00:00.000Z",
								"npmpro_reuse_key": false,
								"npmpro_dns_challenge": false,
								"npmpro_dns_provider": "",
								"npmpro_dns_credential_id": null,
								"npmpro_propagation_seconds": 0
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/certificate-object.json"
					}
				}
			}
		}
	},
	"description": "Deletes a certificate for good. A certificate a host uses (as its certificate or its client CA) or the default certificate is refused with a 400. A Let's Encrypt certificate is revoked and deleted from the ACME state too (best effort), and the files of any certificate are removed. The answer is the certificate as it was.\n\nNeeds: Certificates manage and the token's Allow delete switch"
}
