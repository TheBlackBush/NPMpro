{
	"operationId": "renewCertificate",
	"summary": "Renew a certificate",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "certID",
			"description": "ID of the Let's Encrypt certificate, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 5
		}
	],
	"responses": {
		"200": {
			"description": "The renewed certificate with its new expiry",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 5,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2027-01-15T09:30:00.000Z",
								"owner_user_id": 1,
								"provider": "letsencrypt",
								"nice_name": "app.example.com",
								"domain_names": [
									"app.example.com"
								],
								"expires_on": "2027-04-15T09:30:00.000Z",
								"npmpro_reuse_key": false,
								"npmpro_dns_challenge": false,
								"npmpro_dns_provider": "",
								"npmpro_dns_credential_id": null,
								"npmpro_propagation_seconds": 0
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/certificate-object.json"
					}
				}
			}
		}
	},
	"description": "Renews a Let's Encrypt certificate now and reloads nginx; NPMpro also renews them on its own before they expire. It waits for the ACME server, which can take minutes. A custom or mTLS certificate answers 400.\n\nNeeds: Certificates manage"
}
