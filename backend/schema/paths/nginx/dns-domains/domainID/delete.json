{
	"operationId": "deleteDnsDomain",
	"summary": "Delete a DNS domain",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "domainID",
			"description": "ID of the DNS domain, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The domain that was deleted",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 2,
								"created_on": "2026-11-23T09:30:00.000Z",
								"modified_on": "2026-11-23T09:30:00.000Z",
								"dns_credential_id": 1,
								"name": "example.org",
								"source": "typed"
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/dns-domain-object.json"
					}
				}
			}
		}
	},
	"description": "Deletes the domain. Hosts and certificates keep their names.\n\nNeeds: Certificates manage and the token's Allow delete switch"
}
