{
	"operationId": "getDnsDomain",
	"summary": "Get a DNS domain",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "domainID",
			"description": "ID of the DNS domain, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		},
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add to the answer: `credential` (the DNS credential of the domain, with its owner)",
			"schema": {
				"type": "string",
				"enum": [
					"credential"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The DNS domain",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-23T09:30:00.000Z",
								"modified_on": "2026-11-23T09:30:00.000Z",
								"dns_credential_id": 1,
								"name": "example.com",
								"source": "typed"
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/dns-domain-object.json"
					}
				}
			}
		}
	},
	"description": "Returns one DNS domain.\n\nNeeds: Certificates view"
}
