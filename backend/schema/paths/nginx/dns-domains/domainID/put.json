{
	"operationId": "moveDnsDomain",
	"summary": "Move a DNS domain to another credential",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "domainID",
			"description": "ID of the DNS domain, as the list shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"requestBody": {
		"description": "The credential to move the domain to",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"dns_credential_id"
					],
					"properties": {
						"dns_credential_id": {
							"type": "integer",
							"minimum": 1,
							"description": "ID of the DNS credential that takes the domain over; it must belong to the same owner",
							"example": 2
						}
					}
				},
				"example": {
					"dns_credential_id": 2
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The moved DNS domain",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-23T09:30:00.000Z",
								"modified_on": "2026-11-23T09:30:00.000Z",
								"dns_credential_id": 2,
								"name": "example.com",
								"source": "typed"
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/dns-domain-object.json"
					}
				}
			}
		}
	},
	"description": "Moves a DNS domain to another DNS credential. The new credential must belong to the same owner.\n\nNeeds: Certificates manage"
}
