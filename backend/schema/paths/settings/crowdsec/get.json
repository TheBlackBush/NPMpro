{
	"operationId": "getCrowdsecSettings",
	"summary": "Get the CrowdSec bouncer settings",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The CrowdSec settings as they are now",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/crowdsec-setting-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"enabled": true,
								"api_url": "http://127.0.0.1:8080",
								"api_key_set": true,
								"use_tls_auth": false,
								"tls_client_cert": "",
								"tls_client_key": "",
								"cache_expiration": 1,
								"bouncing_on_type": "all",
								"fallback_remediation": "ban",
								"request_timeout": 3000,
								"update_frequency": 10,
								"enable_internal": false,
								"mode": "live",
								"scenarios_containing": "",
								"scenarios_not_containing": "",
								"exclude_location": "",
								"ban_response": "page",
								"ban_template_path": "/data/public/pages/global/ban.html",
								"redirect_location": "",
								"ret_code": null,
								"captcha_provider": "",
								"captcha_secret_set": false,
								"captcha_site_key": "",
								"captcha_template_path": "/data/public/pages/global/captcha.html",
								"captcha_expiration": 3600,
								"appsec_url": "",
								"appsec_failure_action": "deny",
								"appsec_connect_timeout": null,
								"appsec_send_timeout": null,
								"appsec_process_timeout": null,
								"always_send_to_appsec": false,
								"appsec_drop_unreadable_body": true,
								"ssl_verify": true,
								"admin_ui": "checked",
								"locked": [],
								"locked_by": {},
								"secret_error": false,
								"status": {
									"loaded": true,
									"reachable": true,
									"last_contact": "2026-11-17T09:30:00.000Z",
									"error": null
								}
							}
						}
					}
				}
			}
		}
	},
	"description": "Returns the effective bouncer settings: the saved values with the ones set by environment variables on top (listed in locked and locked_by), and the bouncer's status. The API key and the captcha secret are never returned; api_key_set and captcha_secret_set say whether they exist.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
