{
	"operationId": "uploadOidcIcon",
	"summary": "Upload the OIDC button icon",
	"description": "Saves an image as the icon of the OIDC button on the sign-in page, replacing any earlier icon. PNG, JPEG, WebP or SVG, recognized from the content, at most 256 KB. An SVG with scripts, event handlers or javascript: addresses is refused with 400. Send it as multipart/form-data with the file in the field file.\nNeeds: a signed-in session (API tokens are refused). Administrators only",
	"tags": [
		"Settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "Icon image, at most 256 KB",
		"required": true,
		"content": {
			"multipart/form-data": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"file"
					],
					"properties": {
						"file": {
							"type": "string",
							"format": "binary"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The OIDC settings as they are now, without the client secret",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/oidc-setting-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"enabled": true,
								"issuer_url": "https://id.example.com/application/o/npmpro/",
								"client_id": "npmpro",
								"client_secret_set": true,
								"redirect_domain": "npm.example.com",
								"scopes": "openid email profile",
								"require_verified_email": true,
								"skip_mfa": false,
								"disable_password": false,
								"auto_create": {
									"enabled": false,
									"allowed_domains": [],
									"permissions": {
										"visibility": "user",
										"proxy_hosts": "view",
										"redirection_hosts": "view",
										"dead_hosts": "view",
										"streams": "view",
										"access_lists": "view",
										"certificates": "view"
									}
								},
								"button": {
									"label": "OIDC",
									"color": "#206bc4",
									"icon": {
										"type": "file",
										"ext": "svg",
										"updated_on": 1763371800000
									}
								},
								"locked": [],
								"locked_by": {},
								"active": true,
								"secret_error": false,
								"callback_url": "https://npm.example.com/api/oidc/callback",
								"session_auth_method": "oidc"
							}
						}
					}
				}
			}
		},
		"403": {
			"description": "Not allowed: API tokens are refused here, use a signed-in session. The answer is an error with the message `API tokens cannot be used for this request`."
		}
	}
}
