{
	"operationId": "getRuntimeLogsSettings",
	"summary": "Get the log files settings",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"write_log_files": false,
								"log_rotations": 3,
								"locked": [],
								"applies": {
									"write_log_files": "reload",
									"log_rotations": "immediately"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/runtime-logs-setting-object.json"
					}
				}
			}
		}
	}
}
