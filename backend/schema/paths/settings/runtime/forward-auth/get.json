{
	"operationId": "getRuntimeForwardAuthSettings",
	"summary": "Get the forward authentication settings",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The forward authentication settings as they are now",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"anubis_upstream": "",
								"tinyauth_upstream": "",
								"oauth2proxy_upstream": "",
								"voidauth_upstream": "",
								"authelia_upstream": "",
								"authentik_upstream": "",
								"anubis_custom_images": false,
								"locked": [],
								"locked_by": {},
								"locked_reason": {},
								"applies": {
									"anubis_upstream": "reload",
									"tinyauth_upstream": "reload",
									"oauth2proxy_upstream": "reload",
									"voidauth_upstream": "reload",
									"authelia_upstream": "reload",
									"authentik_upstream": "reload",
									"anubis_custom_images": "reload"
								},
								"restart_pending": []
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/runtime-forward-auth-setting-object.json"
					}
				}
			}
		}
	},
	"description": "Returns the default upstreams of the forward authentication providers (Anubis, Tinyauth, OAuth2 Proxy, VoidAuth, Authelia, Authentik) and the Anubis custom images switch. A value an environment variable sets is shown as locked.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
