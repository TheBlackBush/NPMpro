{
	"operationId": "updateRuntimeNetworkSettings",
	"summary": "Update the network settings",
	"description": "Fields set by environment variables are ignored. The change is applied before it is saved: when applying fails, nothing is saved.",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "Settings payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"trusted_ips": {
							"type": "array",
							"maxItems": 1000,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 64
							},
							"description": "IPv4/IPv6 addresses or CIDR ranges whose X-Forwarded-For / PROXY protocol address is trusted (env TRUST_IP)",
							"example": [
								"192.168.0.0/16",
								"fd00::/8"
							]
						},
						"trust_cloudflare": {
							"type": "boolean",
							"description": "Trust the Cloudflare IP ranges (env TRUST_CLOUDFLARE)"
						}
					}
				},
				"example": {
					"trusted_ips": []
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"trusted_ips": [],
								"trust_cloudflare": false,
								"locked": [],
								"applies": {
									"trusted_ips": "reload",
									"trust_cloudflare": "reload"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/runtime-network-setting-object.json"
					}
				}
			}
		}
	}
}
