{
	"operationId": "getRuntimeNetworkSettings",
	"summary": "Get the network settings",
	"tags": [
		"Settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The network settings as they are now",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"trusted_ips": [
									"10.0.0.5",
									"192.168.0.0/16"
								],
								"trust_cloudflare": false,
								"locked": [],
								"locked_by": {},
								"locked_reason": {},
								"applies": {
									"trusted_ips": "reload",
									"trust_cloudflare": "reload"
								},
								"restart_pending": []
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/runtime-network-setting-object.json"
					}
				}
			}
		}
	},
	"description": "Returns the network settings: the trusted proxy addresses and whether the Cloudflare ranges are trusted. A value an environment variable sets is shown as locked.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
