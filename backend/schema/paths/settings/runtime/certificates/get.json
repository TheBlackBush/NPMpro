{
	"operationId": "getRuntimeCertificatesSettings",
	"summary": "Get the certificates and TLS settings",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The certificates and TLS settings as they are now",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"key_type": "ecdsa",
								"key_size": "secp384r1",
								"profile": "shortlived",
								"must_staple": false,
								"server_tls_verify": true,
								"renewal_interval": 3,
								"warning_days": 14,
								"ocsp_stapling": false,
								"custom_ocsp_stapling": false,
								"default_certificate_id": 0,
								"ech_rotation_interval": 1,
								"locked": [],
								"locked_by": {},
								"locked_reason": {},
								"applies": {
									"key_type": "next-certificate",
									"key_size": "next-certificate",
									"profile": "next-certificate",
									"must_staple": "next-certificate",
									"server_tls_verify": "next-certificate",
									"renewal_interval": "immediately",
									"warning_days": "immediately",
									"ocsp_stapling": "reload",
									"custom_ocsp_stapling": "reload",
									"default_certificate_id": "reload",
									"ech_rotation_interval": "immediately"
								},
								"restart_pending": []
							}
						},
						"locked": {
							"summary": "ACME_KEY_SIZE set",
							"value": {
								"key_type": "ecdsa",
								"key_size": "secp384r1",
								"profile": "shortlived",
								"must_staple": false,
								"server_tls_verify": true,
								"renewal_interval": 3,
								"warning_days": 14,
								"ocsp_stapling": false,
								"custom_ocsp_stapling": false,
								"default_certificate_id": 0,
								"ech_rotation_interval": 1,
								"locked": [
									"key_size",
									"key_type"
								],
								"locked_by": {
									"key_size": "ACME_KEY_SIZE",
									"key_type": "ACME_KEY_SIZE"
								},
								"locked_reason": {
									"key_type": "key-size"
								},
								"applies": {
									"key_type": "next-certificate",
									"key_size": "next-certificate",
									"profile": "next-certificate",
									"must_staple": "next-certificate",
									"server_tls_verify": "next-certificate",
									"renewal_interval": "immediately",
									"warning_days": "immediately",
									"ocsp_stapling": "reload",
									"custom_ocsp_stapling": "reload",
									"default_certificate_id": "reload",
									"ech_rotation_interval": "immediately"
								},
								"restart_pending": []
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/runtime-certificates-setting-object.json"
					}
				}
			}
		}
	},
	"description": "Returns the certificate and TLS settings: the key type and size, ACME profile, must-staple, ACME server TLS check, renewal interval, warning days, OCSP stapling, the default certificate and the ECH key rotation interval. A value an environment variable sets is shown as locked.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
