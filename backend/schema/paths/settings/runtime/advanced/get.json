{
	"operationId": "getRuntimeAdvancedSettings",
	"summary": "Get the advanced settings",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"config_beautifier": true,
								"gravatar": true,
								"locked": [],
								"applies": {
									"config_beautifier": "immediately",
									"gravatar": "immediately"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/runtime-advanced-setting-object.json"
					}
				}
			}
		}
	}
}
