{
	"operationId": "getMonitoringSettings",
	"summary": "Get the traffic statistics settings",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"traffic_enabled": true,
								"retention_days": 30,
								"show_ips": false,
								"unique_visitors": false,
								"visitors_cap": 100000,
								"traffic_missing_paths": false,
								"locked": []
							}
						}
					},
					"schema": {
						"$ref": "../../../components/monitoring-setting-object.json"
					}
				}
			}
		}
	}
}
