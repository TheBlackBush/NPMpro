{
	"operationId": "updateMonitoringSettings",
	"summary": "Update the traffic statistics settings",
	"description": "Fields set by environment variables are ignored.",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "Settings payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"traffic_enabled": {
							"type": "boolean",
							"description": "Traffic statistics enabled"
						},
						"retention_days": {
							"type": "integer",
							"minimum": 7,
							"maximum": 365,
							"description": "Days the hourly statistics are kept",
							"example": 30
						},
						"show_ips": {
							"type": "boolean",
							"description": "Store and show client IP addresses"
						}
					}
				},
				"example": {
					"traffic_enabled": true,
					"retention_days": 30
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"traffic_enabled": true,
								"retention_days": 30,
								"show_ips": false,
								"locked": []
							}
						}
					},
					"schema": {
						"$ref": "../../../components/monitoring-setting-object.json"
					}
				}
			}
		}
	}
}
