{
	"operationId": "addAcmeAccount",
	"summary": "Add a CA",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"requestBody": {
		"description": "The CA to add and the values of its account",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"server"
					],
					"properties": {
						"server": {
							"type": "string",
							"maxLength": 255,
							"pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$",
							"description": "The CA's ACME directory URL (https); not the instance CA and without an account yet",
							"example": "https://acme.example.com/directory"
						},
						"email": {
							"type": "string",
							"maxLength": 255,
							"description": "Contact email of the account, empty removes it",
							"example": "ops@example.com"
						},
						"eab_kid": {
							"type": "string",
							"maxLength": 1024,
							"writeOnly": true,
							"description": "EAB key ID, for a CA that needs one",
							"example": "YOUR_EAB_KEY_ID"
						},
						"eab_hmac_key": {
							"type": "string",
							"maxLength": 1024,
							"writeOnly": true,
							"description": "EAB HMAC key, for a CA that needs one",
							"example": "YOUR_EAB_HMAC_KEY"
						}
					}
				},
				"example": {
					"server": "https://acme.example.com/directory",
					"email": "ops@example.com"
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The ACME settings with the new account in accounts; warning unreachable means the account is stored as pending",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"server": "https://acme-v02.api.letsencrypt.org/directory",
								"server_source": "default",
								"email": "ops@example.com",
								"eab_kid_set": false,
								"eab_hmac_key_set": false,
								"account": {
									"id": 1,
									"server": "https://acme-v02.api.letsencrypt.org/directory",
									"email": "ops@example.com",
									"eab_kid_set": false,
									"eab_hmac_key_set": false,
									"state": "registered",
									"error": null,
									"registered_on": "2026-11-19 10:00:00",
									"modified_on": "2026-11-19 10:00:00"
								},
								"locked": [],
								"locked_by": {},
								"presets": [
									{
										"id": "letsencrypt",
										"server": "https://acme-v02.api.letsencrypt.org/directory",
										"eab": false
									},
									{
										"id": "letsencrypt-staging",
										"server": "https://acme-staging-v02.api.letsencrypt.org/directory",
										"eab": false
									},
									{
										"id": "zerossl",
										"server": "https://acme.zerossl.com/v2/DV90",
										"eab": true
									},
									{
										"id": "google",
										"server": "https://dv.acme-v02.api.pki.goog/directory",
										"eab": true
									}
								],
								"accounts": [
									{
										"id": 1,
										"server": "https://acme-v02.api.letsencrypt.org/directory",
										"email": "ops@example.com",
										"eab_kid_set": false,
										"eab_hmac_key_set": false,
										"state": "registered",
										"error": null,
										"registered_on": "2026-11-19 10:00:00",
										"modified_on": "2026-11-19 10:00:00"
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/acme-settings-object.json"
					}
				}
			}
		},
		"400": {
			"description": "The URL is not an https directory (error.acme-url), the CA already has an account (error.acme-exists), or the CA refused the account"
		},
		"403": {
			"description": "Not allowed: the user is not an administrator"
		}
	},
	"description": "Adds a CA that certificates can be requested at: its account is registered now. When the CA cannot be reached the account is stored as pending and the answer carries warning unreachable; a refusal answers 400 and stores nothing. The instance CA and a CA that already has an account cannot be added.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
