{
	"operationId": "deleteAcmeAccount",
	"summary": "Remove the account of a CA",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "accountID",
			"description": "ID of the account, as accounts in the ACME settings shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "The ACME settings after the removal",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"server": "https://acme-v02.api.letsencrypt.org/directory",
								"server_source": "default",
								"email": "ops@example.com",
								"eab_kid_set": false,
								"eab_hmac_key_set": false,
								"account": {
									"id": 1,
									"server": "https://acme-v02.api.letsencrypt.org/directory",
									"email": "ops@example.com",
									"eab_kid_set": false,
									"eab_hmac_key_set": false,
									"state": "registered",
									"error": null,
									"registered_on": "2026-11-19 10:00:00",
									"modified_on": "2026-11-19 10:00:00"
								},
								"locked": [],
								"locked_by": {},
								"presets": [
									{
										"id": "letsencrypt",
										"server": "https://acme-v02.api.letsencrypt.org/directory",
										"eab": false
									},
									{
										"id": "letsencrypt-staging",
										"server": "https://acme-staging-v02.api.letsencrypt.org/directory",
										"eab": false
									},
									{
										"id": "zerossl",
										"server": "https://acme.zerossl.com/v2/DV90",
										"eab": true
									},
									{
										"id": "google",
										"server": "https://dv.acme-v02.api.pki.goog/directory",
										"eab": true
									}
								],
								"accounts": [
									{
										"id": 1,
										"server": "https://acme-v02.api.letsencrypt.org/directory",
										"email": "ops@example.com",
										"eab_kid_set": false,
										"eab_hmac_key_set": false,
										"state": "registered",
										"error": null,
										"registered_on": "2026-11-19 10:00:00",
										"modified_on": "2026-11-19 10:00:00"
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/acme-settings-object.json"
					}
				}
			}
		},
		"400": {
			"description": "The CA is the instance CA or a certificate was issued by it (error.acme-in-use)"
		},
		"403": {
			"description": "Not allowed: the request was made with an API token, or the user is not an administrator"
		},
		"404": {
			"description": "No account has this id"
		}
	},
	"description": "Removes NPMpro's record of a CA. The account stays at the CA and its folder stays on disk. The instance CA's account and the account of a CA that issued a certificate cannot be removed.\n\nNeeds: a signed-in session (API tokens are refused). Administrators only"
}
