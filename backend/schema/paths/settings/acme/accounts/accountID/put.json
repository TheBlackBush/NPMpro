{
	"operationId": "updateAcmeAccount",
	"summary": "Update the account of a CA",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "accountID",
			"description": "ID of the account, as accounts in the ACME settings shows it",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"requestBody": {
		"description": "The account values to change; send only what changes",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"email": {
							"type": "string",
							"maxLength": 255,
							"description": "Contact email of the account, empty removes it",
							"example": "ops@example.com"
						},
						"eab_kid": {
							"type": "string",
							"maxLength": 1024,
							"writeOnly": true,
							"description": "EAB key ID, for a CA that needs one",
							"example": "YOUR_EAB_KEY_ID"
						},
						"eab_hmac_key": {
							"type": "string",
							"maxLength": 1024,
							"writeOnly": true,
							"description": "EAB HMAC key, for a CA that needs one",
							"example": "YOUR_EAB_HMAC_KEY"
						}
					}
				},
				"example": {
					"email": "ops@example.com"
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The ACME settings as they are now; warning unreachable means the account is stored as pending",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"server": "https://acme-v02.api.letsencrypt.org/directory",
								"server_source": "default",
								"email": "ops@example.com",
								"eab_kid_set": false,
								"eab_hmac_key_set": false,
								"account": {
									"id": 1,
									"server": "https://acme-v02.api.letsencrypt.org/directory",
									"email": "ops@example.com",
									"eab_kid_set": false,
									"eab_hmac_key_set": false,
									"state": "registered",
									"error": null,
									"registered_on": "2026-11-19 10:00:00",
									"modified_on": "2026-11-19 10:00:00"
								},
								"locked": [],
								"locked_by": {},
								"presets": [
									{
										"id": "letsencrypt",
										"server": "https://acme-v02.api.letsencrypt.org/directory",
										"eab": false
									},
									{
										"id": "letsencrypt-staging",
										"server": "https://acme-staging-v02.api.letsencrypt.org/directory",
										"eab": false
									},
									{
										"id": "zerossl",
										"server": "https://acme.zerossl.com/v2/DV90",
										"eab": true
									},
									{
										"id": "google",
										"server": "https://dv.acme-v02.api.pki.goog/directory",
										"eab": true
									}
								],
								"accounts": [
									{
										"id": 1,
										"server": "https://acme-v02.api.letsencrypt.org/directory",
										"email": "ops@example.com",
										"eab_kid_set": false,
										"eab_hmac_key_set": false,
										"state": "registered",
										"error": null,
										"registered_on": "2026-11-19 10:00:00",
										"modified_on": "2026-11-19 10:00:00"
									}
								]
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/acme-settings-object.json"
					}
				}
			}
		},
		"400": {
			"description": "A value is not valid, or the CA refused the account"
		},
		"403": {
			"description": "Not allowed: the user is not an administrator"
		},
		"404": {
			"description": "No account has this id"
		}
	},
	"description": "Changes the email or the EAB pair of a stored CA's account, with the same rules as the instance CA's account: an email change of a registered account needs the CA to answer, EAB values count only while the account is not registered.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
