{
	"operationId": "updateGeoipSettings",
	"summary": "Update the GeoIP settings",
	"description": "Saves the MaxMind account ID, license key and editions; send only what changes. Fields set by environment variables are ignored. An empty or omitted license_key keeps the saved one. A change of the account, key or editions starts a database download in the background; the answer does not wait for it, the outcome shows in last_update and last_error.\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"requestBody": {
		"description": "The settings to change",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"account_id": {
							"type": "string",
							"pattern": "^$|^[0-9]{1,10}$",
							"description": "MaxMind account ID, empty to clear",
							"example": "123456"
						},
						"license_key": {
							"type": "string",
							"maxLength": 255,
							"description": "MaxMind license key, empty keeps the saved one",
							"example": "YOUR_LICENSE_KEY"
						},
						"editions": {
							"type": "array",
							"description": "Databases to download",
							"maxItems": 3,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"enum": [
									"GeoLite2-Country",
									"GeoLite2-ASN",
									"GeoLite2-City"
								]
							}
						}
					}
				},
				"example": {
					"account_id": "123456",
					"license_key": "YOUR_LICENSE_KEY"
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The GeoIP settings as they are now",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"account_id": "123456",
								"editions": [
									"GeoLite2-Country",
									"GeoLite2-ASN"
								],
								"license_key_set": true,
								"locked": [],
								"locked_by": {},
								"secret_error": false,
								"last_update": "2026-11-17T09:30:00.000Z",
								"last_error": null
							}
						}
					},
					"schema": {
						"$ref": "../../../components/geoip-setting-object.json"
					}
				}
			}
		}
	}
}
