							"value": {
								"ok": true,
								"updated": true
							}
						}
					},
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"ok"
						],
						"properties": {
							"ok": {
								"type": "boolean"
							},
							"updated": {
								"type": "boolean",
								"description": "At least one database file was replaced"
							},
							"error": {
								"type": "string",
								"description": "Reason when ok is false"
							}
						}
					}
				}
			}
		}
