{
	"operationId": "updateGeoipNow",
	"summary": "Update the GeoIP databases now",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The result of the update",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"ok": true,
								"updated": [
									"GeoLite2-Country",
									"GeoLite2-ASN"
								],
								"provider": "maxmind"
							}
						}
					},
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"ok",
							"provider"
						],
						"properties": {
							"ok": {
								"type": "boolean",
								"description": "Whether the update succeeded"
							},
							"updated": {
								"type": "array",
								"description": "The editions whose database file was replaced; can be filled even when ok is false",
								"items": {
									"type": "string",
									"enum": [
										"GeoLite2-Country",
										"GeoLite2-ASN",
										"GeoLite2-City",
										"Country",
										"ASN"
									]
								}
							},
							"error": {
								"type": "string",
								"description": "Why the update failed; only when ok is false"
							},
							"provider": {
								"type": "string",
								"enum": [
									"dbip",
									"maxmind"
								],
								"description": "The provider the run used"
							}
						}
					}
				}
			}
		}
	},
	"description": "Downloads the selected databases of the active provider (DB-IP Lite or MaxMind GeoLite2) now and waits for the result, which can take a while. A failure answers 200 with ok false and the reason in error; updated can still list editions that were replaced.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
