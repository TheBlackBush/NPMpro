{
	"operationId": "updateGeoipNow",
	"summary": "Update the GeoIP databases now",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"ok": true,
								"updated": [
									"GeoLite2-Country",
									"GeoLite2-ASN"
								]
							}
						}
					},
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"ok"
						],
						"properties": {
							"ok": {
								"type": "boolean"
							},
							"updated": {
								"type": "array",
								"description": "Editions whose database file was replaced (can be non-empty when ok is false)",
								"items": {
									"type": "string",
									"enum": [
										"GeoLite2-Country",
										"GeoLite2-ASN",
										"GeoLite2-City"
									]
								}
							},
							"error": {
								"type": "string",
								"description": "Reason when ok is false"
							}
						}
					}
				}
			}
		}
	}
}
