{
	"operationId": "getLandingPages",
	"summary": "Get the landing pages",
	"description": "Returns the default site, the seven global pages (the built-in one or a custom HTML each) and the visit time. A page that was never customized answers with choice npmpro.\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The landing page settings as they are now",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/landing-pages-setting-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"visit_time": "utc",
								"default_site": {
									"value": "congratulations",
									"meta": {}
								},
								"pages": {
									"not_found": {
										"choice": "npmpro",
										"html": ""
									},
									"upstream_error": {
										"choice": "npmpro",
										"html": ""
									},
									"denied": {
										"choice": "npmpro",
										"html": ""
									},
									"maintenance": {
										"choice": "custom",
										"html": "<h1>Back soon</h1>"
									},
									"certificate": {
										"choice": "npmpro",
										"html": ""
									},
									"ban": {
										"choice": "npmpro",
										"html": ""
									},
									"captcha": {
										"choice": "npmpro",
										"html": ""
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
