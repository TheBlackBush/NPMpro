{
	"operationId": "getWebhook",
	"summary": "Get a webhook",
	"description": "One webhook with the state of its newest delivery. The URL and the secrets are never returned.\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "id",
			"description": "Webhook id",
			"required": true,
			"schema": {
				"type": "string",
				"pattern": "^[1-9]\\d{0,9}$"
			},
			"example": "1"
		}
	],
	"responses": {
		"200": {
			"description": "The webhook",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/webhook-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-27T09:30:00.000Z",
								"modified_on": "2026-11-27T09:30:00.000Z",
								"name": "Chat bridge",
								"url_hint": "https://hooks.example.com/npmpro",
								"url_set": true,
								"secret_set": true,
								"secret_error": false,
								"events": [
									"certificate.expiring",
									"backup.failed"
								],
								"enabled": true,
								"verify_tls": true,
								"disabled_reason": null,
								"failing_since": null,
								"last_success_on": "2026-11-27T10:00:00.000Z",
								"last_delivery": {
									"status": "sent",
									"http_status": 200,
									"created_on": "2026-11-27T10:00:00.000Z"
								}
							}
						}
					}
				}
			}
		}
	}
}
