{
	"operationId": "rotateWebhookSecret",
	"summary": "Rotate the signing secret",
	"description": "Makes a new signing secret, shown once in the answer. The old one signs too for 24 hours, so a receiver can switch over: each delivery then carries two signatures.\n\nNeeds: a signed-in session (API tokens are refused). Administrators only",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "id",
			"description": "Webhook id",
			"required": true,
			"schema": {
				"type": "string",
				"pattern": "^[1-9]\\d{0,9}$"
			},
			"example": "1"
		}
	],
	"responses": {
		"200": {
			"description": "The webhook with its new secret, shown once",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/webhook-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-27T09:30:00.000Z",
								"modified_on": "2026-11-27T09:30:00.000Z",
								"name": "Chat bridge",
								"url_hint": "https://hooks.example.com/npmpro",
								"url_set": true,
								"secret_set": true,
								"secret_error": false,
								"events": [
									"certificate.expiring",
									"backup.failed"
								],
								"enabled": true,
								"verify_tls": true,
								"disabled_reason": null,
								"failing_since": null,
								"last_success_on": "2026-11-27T10:00:00.000Z",
								"last_delivery": {
									"status": "sent",
									"http_status": 200,
									"created_on": "2026-11-27T10:00:00.000Z"
								},
								"secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSwaGVsbG8gd29ybGQ="
							}
						}
					}
				}
			}
		}
	}
}
