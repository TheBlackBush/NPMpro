{
	"operationId": "getWebhookDeliveries",
	"summary": "List the deliveries of a webhook",
	"description": "The deliveries of one webhook, newest first, never their content. NPMpro keeps the newest 100 finished deliveries of a webhook and none older than 30 days.\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "id",
			"description": "Webhook id",
			"required": true,
			"schema": {
				"type": "string",
				"pattern": "^[1-9]\\d{0,9}$"
			},
			"example": "1"
		},
		{
			"in": "query",
			"name": "offset",
			"description": "Deliveries to skip",
			"schema": {
				"type": "integer",
				"minimum": 0,
				"default": 0
			}
		},
		{
			"in": "query",
			"name": "limit",
			"description": "Deliveries in the page, at most 100",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 100,
				"default": 25
			}
		}
	],
	"responses": {
		"200": {
			"description": "The deliveries",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/webhook-delivery-list.json"
					},
					"examples": {
						"default": {
							"value": [
								{
									"id": 41,
									"message_id": "msg_p7n3u2x5r4f6a1z9c8b2d3e4f5",
									"event": "backup.failed",
									"status": "failed",
									"attempts": 8,
									"next_try_on": null,
									"http_status": 500,
									"duration_ms": 312,
									"error": "The endpoint's answer was an error (500)",
									"response": "internal error",
									"created_on": "2026-11-26T09:12:00.000Z",
									"modified_on": "2026-11-26T20:12:00.000Z",
									"redeliverable": true
								}
							]
						}
					}
				}
			},
			"headers": {
				"X-Total-Count": {
					"description": "Number of deliveries of the webhook, over all pages",
					"schema": {
						"type": "integer"
					}
				}
			}
		}
	}
}
