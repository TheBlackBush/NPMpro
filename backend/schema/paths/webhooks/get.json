{
	"operationId": "getWebhooks",
	"summary": "List the webhooks",
	"description": "Every webhook by name with the state of its newest delivery. The URL and the secrets are never returned: url_hint shows the start of the address.\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The webhooks",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../components/webhook-list.json"
					},
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"created_on": "2026-11-27T09:30:00.000Z",
									"modified_on": "2026-11-27T09:30:00.000Z",
									"name": "Chat bridge",
									"url_hint": "https://hooks.example.com/npmpro",
									"url_set": true,
									"secret_set": true,
									"secret_error": false,
									"events": [
										"certificate.expiring",
										"backup.failed"
									],
									"enabled": true,
									"verify_tls": true,
									"disabled_reason": null,
									"failing_since": null,
									"last_success_on": "2026-11-27T10:00:00.000Z",
									"last_delivery": {
										"status": "sent",
										"http_status": 200,
										"created_on": "2026-11-27T10:00:00.000Z"
									}
								}
							]
						}
					}
				}
			}
		}
	}
}
