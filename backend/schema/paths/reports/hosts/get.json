{
	"operationId": "reportsHosts",
	"summary": "Get the dashboard host counts",
	"tags": [
		"Dashboard"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The counts the dashboard shows",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"proxy": 20,
								"redirection": 1,
								"stream": 0,
								"dead": 1,
								"access_list": 2,
								"certificate": 15,
								"errors": {
									"proxy": 1,
									"redirection": 0,
									"dead": 0,
									"stream": 0
								},
								"certificates_expiring": 2,
								"certificates_expired": 1,
								"backup_schedules_failed": [
									{
										"id": 2,
										"name": "Nightly"
									}
								]
							}
						}
					},
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"proxy": {
								"type": "integer",
								"description": "Proxy Hosts Count",
								"example": 20
							},
							"redirection": {
								"type": "integer",
								"description": "Redirection Hosts Count",
								"example": 2
							},
							"stream": {
								"type": "integer",
								"description": "Streams Count",
								"example": 0
							},
							"dead": {
								"type": "integer",
								"description": "404 Hosts Count",
								"example": 3
							},
							"access_list": {
								"type": "integer",
								"description": "Access Lists Count",
								"example": 2
							},
							"certificate": {
								"type": "integer",
								"description": "Certificates Count",
								"example": 15
							},
							"errors": {
								"type": "object",
								"description": "Enabled hosts whose nginx configuration was rejected",
								"additionalProperties": false,
								"properties": {
									"proxy": {
										"type": "integer",
										"description": "Proxy Hosts With Config Error",
										"example": 1
									},
									"redirection": {
										"type": "integer",
										"description": "Redirection Hosts With Config Error",
										"example": 0
									},
									"dead": {
										"type": "integer",
										"description": "404 Hosts With Config Error",
										"example": 0
									},
									"stream": {
										"type": "integer",
										"description": "Streams With Config Error",
										"example": 0
									}
								},
								"required": [
									"proxy",
									"redirection",
									"dead",
									"stream"
								]
							},
							"certificates_expiring": {
								"type": "integer",
								"description": "Certificates (Let's Encrypt or other providers) expiring within 14 days",
								"example": 2
							},
							"certificates_expired": {
								"type": "integer",
								"description": "Certificates (Let's Encrypt or other providers) already expired",
								"example": 1
							},
							"backup_schedules_failed": {
								"type": "array",
								"description": "Enabled backup schedules whose last run failed; administrators only, empty otherwise",
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"id",
										"name"
									],
									"properties": {
										"id": {
											"type": "integer",
											"description": "ID of the backup schedule"
										},
										"name": {
											"type": "string",
											"description": "Name of the backup schedule"
										}
									}
								}
							}
						},
						"required": [
							"errors",
							"certificates_expiring",
							"certificates_expired",
							"backup_schedules_failed"
						]
					}
				}
			}
		}
	},
	"description": "Counts the hosts, streams, access lists and certificates the user may see (an administrator or a user with visibility `all` sees every one, otherwise only their own). The config error and certificate expiry counts are 0 for a section the user cannot view. `backup_schedules_failed` is filled for administrators only and is empty for everyone else. Certificates count as expiring within 14 days.\n\nNeeds: a signed-in user (a session or an API token); each count follows the user's permissions"
}
