								"status": {
									"enabled": true,
									"geoip": true,
									"skipped_lines": 0,
									"dropped_requests": 0,
									"last_read": "2026-10-24T10:00:05.000Z",
									"error": null,
									"unique_visitors": true,
									"visitors_error": null
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../components/monitoring-traffic-object.json"
					}
				}
			}
		}
	}
}
