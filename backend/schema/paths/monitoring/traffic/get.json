{
	"operationId": "getMonitoringTraffic",
	"summary": "Get the traffic statistics",
	"tags": [
		"monitoring"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "range",
			"description": "Time range: minute buckets for 1h and 24h, hour buckets for 7d and 30d",
			"schema": {
				"type": "string",
				"enum": [
					"1h",
					"24h",
					"7d",
					"30d"
				],
				"default": "24h"
			}
		},
		{
			"in": "query",
			"name": "host",
			"description": "Stored host key to filter by: a domain name, a wildcard name or _other (empty for all hosts). Ignored when host_id and host_type are given",
			"schema": {
				"type": "string",
				"maxLength": 255,
				"default": ""
			}
		},
		{
			"in": "query",
			"name": "host_id",
			"description": "Id of the NPMpro host to filter by, together with host_type: all its domain names. 404 when the host does not exist",
			"schema": {
				"type": "integer",
				"minimum": 1
			}
		},
		{
			"in": "query",
			"name": "host_type",
			"description": "Type of the host given by host_id",
			"schema": {
				"type": "string",
				"enum": [
					"proxy",
					"redirection",
					"dead"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"totals": {
									"requests": 1520,
									"bytes": 48211337,
									"error_rate": 0.042,
									"visitors": 410,
									"visitors_capped": false
								},
								"series": [
									{
										"bucket": 29401000,
										"by_class": {
											"2xx": 20,
											"3xx": 2,
											"4xx": 1,
											"5xx": 0
										}
									}
								],
								"top_hosts": [
									{
										"host_id": 3,
										"host_type": "proxy",
										"name": "example.com",
										"domain_names": [
											"example.com",
											"www.example.com"
										],
										"requests": 1200,
										"bytes": 40000000,
										"visitors": 350,
										"visitors_capped": false
									},
									{
										"host_id": null,
										"host_type": "other",
										"name": "_other",
										"domain_names": [],
										"requests": 320,
										"bytes": 8211337,
										"visitors": 60,
										"visitors_capped": false
									}
								],
								"top_countries": [
									{
										"country": "DE",
										"requests": 900
									},
									{
										"country": "US",
										"requests": 400
									}
								],
								"top_asns": [
									{
										"asn": 3320,
										"asn_name": "Deutsche Telekom AG",
										"requests": 700
									}
								],
								"top_404_paths": [
									{
										"path": "/wp-login.php",
										"requests": 42,
										"last_seen": "2026-10-24T09:58:00.000Z"
									}
								],
								"countries": [
									{
										"country": "DE",
										"requests": 900
