{
	"operationId": "getMonitoringSummary",
	"summary": "Get the dashboard monitoring summary",
	"tags": [
		"monitoring"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "Today's traffic numbers and the CrowdSec ban counts, null where unavailable",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"requests_today": 1520,
								"series_24h": [
									{
										"bucket": 490016,
										"requests": 64
									}
								],
								"error_rate_today": 0.042,
								"client_errors_today": 37,
								"server_errors_today": 5,
								"active_bans": 12,
								"bans_added_24h": 3,
								"top_ban_reasons": [
									{
										"scenario": "crowdsecurity/http-probing",
										"count": 5
									},
									{
										"scenario": "crowdsecurity/ssh-bf",
										"count": 2
									}
								],
								"top_country_today": "DE",
								"top_countries_today": [
									{
										"country": "DE",
										"requests": 610
									},
									{
										"country": "US",
										"requests": 402
									},
									{
										"country": "FR",
										"requests": 77
									}
								],
								"visitors_today": 214
							}
						}
					},
					"schema": {
						"$ref": "../../../components/monitoring-summary-object.json"
					}
				}
			}
		}
	},
	"description": "Returns the numbers of the dashboard cards: requests, error counts and countries of today (the UTC day so far) and, when CrowdSec is configured and reachable, its active bans. A number is null when its source is off or not available, for example traffic statistics switched off, no GeoIP database or CrowdSec not configured.\n\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
