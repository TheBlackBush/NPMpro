{
	"operationId": "getBackupTypes",
	"summary": "List the backup parts with their counts",
	"description": "The parts a backup can hold, grouped as the backup window shows them, with how many rows or files each has now and how many certificates each provider has. Also the container time zone that schedules use.\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"Backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "The categories of parts, the counts per part, the certificates per provider and the time zone",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"categories",
							"counts",
							"certificateKinds",
							"time_zone"
						],
						"properties": {
							"categories": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"id",
										"types"
									],
									"properties": {
										"id": {
											"type": "string",
											"description": "The group: hosts, certificates, access_lists, dns_credentials, users, settings or custom_files."
										},
										"types": {
											"type": "array",
											"items": {
												"type": "string",
												"enum": [
													"proxy_hosts",
													"redirection_hosts",
													"dead_hosts",
													"streams",
													"certificates",
													"access_lists",
													"dns_credentials",
													"users",
													"settings_runtime",
													"settings_default_site",
													"settings_landing_pages",
													"settings_oidc",
													"settings_monitoring",
													"settings_crowdsec",
													"custom_nginx",
													"crowdsec_files",
													"backup_schedules"
												]
											},
											"description": "The parts of the group."
										}
									}
								},
								"description": "The parts in the groups the backup window shows."
							},
							"counts": {
								"type": "object",
								"additionalProperties": {
									"type": "integer"
								},
								"description": "Rows or files per type"
							},
							"certificateKinds": {
								"type": "object",
								"additionalProperties": {
									"type": "integer"
								},
								"description": "Certificates per provider"
							},
							"time_zone": {
								"type": "string",
								"description": "The container time zone schedules use"
							}
						}
					},
					"examples": {
						"default": {
							"value": {
								"categories": [
									{
										"id": "hosts",
										"types": [
											"proxy_hosts",
											"redirection_hosts",
											"dead_hosts",
											"streams"
										]
									},
									{
										"id": "certificates",
										"types": [
											"certificates"
										]
									},
									{
										"id": "access_lists",
										"types": [
											"access_lists"
										]
									},
									{
										"id": "users",
										"types": [
											"users"
										]
									}
								],
								"counts": {
									"proxy_hosts": 12,
									"redirection_hosts": 2,
									"dead_hosts": 1,
									"streams": 0,
									"certificates": 5,
									"access_lists": 3,
									"users": 2
								},
								"certificateKinds": {
									"letsencrypt": 4,
									"other": 1
								},
								"time_zone": "UTC"
							}
						}
					}
				}
			}
		}
	}
}
