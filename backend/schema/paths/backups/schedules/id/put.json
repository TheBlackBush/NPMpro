{
	"operationId": "updateBackupSchedule",
	"summary": "Update a backup schedule",
	"description": "Changes the fields sent; the next run is worked out again. Sending only enabled pauses or resumes the schedule. Leave the passphrase out or empty to keep the stored one. Errors carry a backup.schedule.error.<code> message id: name, name-taken, frequency, every-hours, time, weekday, month-day, types, protection, keep, passphrase, passphrase-required.\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "id",
			"description": "Schedule id",
			"required": true,
			"schema": {
				"type": "string",
				"pattern": "^[1-9]\\d{0,9}$"
			},
			"example": "1"
		}
	],
	"requestBody": {
		"description": "Fields to change",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"name": {
							"type": "string",
							"minLength": 1,
							"maxLength": 60,
							"description": "Unique, case insensitive"
						},
						"enabled": {
							"type": "boolean",
							"description": "Whether the schedule makes backups; default true. A paused schedule keeps its settings and files."
						},
						"frequency": {
							"type": "string",
							"enum": [
								"hours",
								"daily",
								"weekly",
								"monthly"
							],
							"description": "hours: every every_hours hours; daily: every day at time; weekly: on weekday at time; monthly: on month_day at time."
						},
						"every_hours": {
							"type": "integer",
							"minimum": 1,
							"maximum": 24,
							"description": "Hours between runs (1 to 24); for frequency hours."
						},
						"time": {
							"type": "string",
							"pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
							"description": "HH:MM in the container time zone"
						},
						"weekday": {
							"type": "integer",
							"minimum": 0,
							"maximum": 6,
							"description": "0 = Monday"
						},
						"month_day": {
							"type": "integer",
							"minimum": 1,
							"maximum": 28,
							"description": "Day of the month (1 to 28); for frequency monthly."
						},
						"types": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"ddns",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_landing_pages",
									"settings_oidc",
									"settings_notifications",
									"settings_monitoring",
									"settings_crowdsec",
									"custom_nginx",
									"crowdsec_files",
									"backup_schedules"
								]
							},
							"minItems": 1,
							"uniqueItems": true,
							"description": "The parts the schedule backs up, as in the types list of POST /backups."
						},
						"protection": {
							"type": "string",
							"enum": [
								"passphrase",
								"instance_key",
								"none"
							],
							"description": "passphrase: secrets included, encrypted with the passphrase, which is stored encrypted on this instance; instance_key: secrets included, encrypted with this instance's key (restores only here); none: no secrets, not encrypted."
						},
						"passphrase": {
							"type": "string",
							"maxLength": 1024,
							"description": "Empty or left out keeps the stored one"
						},
						"keep": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100,
							"description": "Files to keep"
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"enabled": false
						}
					},
					"weekly": {
						"value": {
							"frequency": "weekly",
							"weekday": 0,
							"time": "02:00",
							"keep": 4
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The updated schedule",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/backup-schedule-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"name": "Nightly",
								"enabled": false,
								"frequency": "daily",
								"every_hours": null,
								"time": "03:30",
								"weekday": null,
								"month_day": null,
								"types": [
									"proxy_hosts",
									"certificates",
									"access_lists"
								],
								"protection": "passphrase",
								"keep": 7,
								"next_run_at": null,
								"last_run_at": "2026-11-17T03:30:00.000Z",
								"last_status": "success",
								"last_error": null,
								"last_file": "npmpro-backup-npmpro-20261117-033000-s1.npmpro",
								"last_size": 482113,
								"last_duration_ms": 840,
								"passphrase_set": true,
								"file_count": 7
							}
						}
					}
				}
			}
		}
	}
}
