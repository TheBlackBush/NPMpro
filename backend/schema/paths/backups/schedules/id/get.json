{
	"operationId": "getBackupSchedule",
	"summary": "Get a backup schedule",
	"description": "One schedule with its timing, protection and last run. The passphrase is never returned.\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"Backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "id",
			"description": "Schedule id",
			"required": true,
			"schema": {
				"type": "string",
				"pattern": "^[1-9]\\d{0,9}$"
			},
			"example": "1"
		}
	],
	"responses": {
		"200": {
			"description": "The schedule",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/backup-schedule-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"owner_user_id": 1,
								"name": "Nightly",
								"enabled": true,
								"frequency": "daily",
								"every_hours": null,
								"time": "03:30",
								"weekday": null,
								"month_day": null,
								"types": [
									"proxy_hosts",
									"certificates",
									"access_lists"
								],
								"protection": "passphrase",
								"keep": 7,
								"next_run_at": "2026-11-18T03:30:00.000Z",
								"last_run_at": "2026-11-17T03:30:00.000Z",
								"last_status": "success",
								"last_error": null,
								"last_file": "npmpro-backup-npmpro-20261117-033000-s1.npmpro",
								"last_size": 482113,
								"last_duration_ms": 840,
								"passphrase_set": true,
								"file_count": 7
							}
						}
					}
				}
			}
		}
	}
}
