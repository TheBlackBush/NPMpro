{
	"operationId": "createBackup",
	"summary": "Create a backup",
	"description": "Writes a backup of the chosen parts. With keep it is stored in the backups folder and returned as entry; without keep it is returned as a pending download (GET /backups/pending/{id}), which can be fetched once within 30 minutes. With secrets the file holds private keys, password hashes and credentials and is encrypted with the passphrase (at least 12 characters, never stored); without secrets it is not encrypted. API tokens are never part of a backup. busy (409) while another backup or restore runs. Errors carry a backup.error.<code> message id: invalid-types, weak-passphrase, busy.\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"requestBody": {
		"description": "Backup options",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"types",
						"secrets",
						"keep"
					],
					"properties": {
						"types": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"ddns",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_landing_pages",
									"settings_oidc",
									"settings_notifications",
									"settings_monitoring",
									"settings_crowdsec",
									"custom_nginx",
									"crowdsec_files",
									"backup_schedules",
									"webhooks"
								]
							},
							"minItems": 1,
							"uniqueItems": true,
							"description": "Backup types"
						},
						"secrets": {
							"type": "boolean",
							"description": "Include secrets, encrypted with the passphrase"
						},
						"passphrase": {
							"type": "string",
							"minLength": 12,
							"maxLength": 1024,
							"description": "Passphrase, at least 12 characters, never stored"
						},
						"keep": {
							"type": "boolean",
							"description": "Store the backup on the server"
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"types": [
								"proxy_hosts",
								"certificates",
								"access_lists"
							],
							"secrets": true,
							"passphrase": "YOUR_PASSPHRASE",
							"keep": true
						}
					},
					"download": {
						"value": {
							"types": [
								"proxy_hosts"
							],
							"secrets": false,
							"keep": false
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The stored backup (with keep), or the pending download id and file name (without keep)",
			"content": {
				"application/json": {
					"schema": {
						"oneOf": [
							{
								"type": "object",
								"additionalProperties": false,
								"required": [
									"entry"
								],
								"properties": {
									"entry": {
										"$ref": "../../components/backup-object.json"
									}
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": [
									"pending",
									"name"
								],
								"properties": {
									"pending": {
										"type": "string",
										"description": "The id to download the file with, once, from GET /backups/pending/{id}."
									},
									"name": {
										"type": "string",
										"description": "The file name to offer for the download."
									}
								}
							}
						]
					},
					"examples": {
						"default": {
							"value": {
								"entry": {
									"name": "npmpro-backup-npmpro-20261117-093000.npmpro",
									"size": 482113,
									"modified": "2026-11-17T09:30:00.000Z",
									"auto": false,
									"summary": {
										"format": 1,
										"types": [
											"proxy_hosts",
											"certificates",
											"access_lists"
										],
										"counts": {
											"proxy_hosts": 12,
											"certificates": 5,
											"access_lists": 3
										},
										"created_at": "2026-11-17T09:30:00.000Z",
										"npmpro_version": "1.0.0",
										"secrets": true
									},
									"encrypted": true,
									"schedule_id": null,
									"instance_key": false
								}
							}
						},
						"download": {
							"value": {
								"pending": "k3j9x2m1q8w7e6r5",
								"name": "npmpro-backup-npmpro-20261117-093000.npmpro"
							}
						}
					}
				}
			}
		}
	}
}
