{
	"operationId": "deleteBackup",
	"summary": "Delete a stored backup",
	"description": "Removes the file from the backups folder and writes an audit log entry. The file can be an automatic one or a scheduled one.\n\nNeeds: an administrator (a token needs its Administrator switch) and the token's Allow delete switch",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "name",
			"description": "Backup file name",
			"schema": {
				"type": "string",
				"pattern": "^npmpro-backup-[a-z0-9-]+-\\d{8}-\\d{6}(-\\d{1,3})?(-s\\d{1,10})?(-auto)?\\.npmpro$",
				"maxLength": 255
			},
			"required": true,
			"example": "npmpro-backup-npmpro-20261026-120000.npmpro"
		}
	],
	"responses": {
		"200": {
			"description": "true when the file was removed",
			"content": {
				"application/json": {
					"schema": {
						"type": "boolean",
						"example": true
					},
					"examples": {
						"default": {
							"value": true
						}
					}
				}
			}
		}
	}
}
