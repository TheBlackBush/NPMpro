{
	"operationId": "downloadBackup",
	"summary": "Download a stored backup",
	"description": "Admin only.",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "name",
			"description": "Backup file name",
			"schema": {
				"type": "string",
				"pattern": "^npmpro-backup-[a-z0-9-]+-\\d{8}-\\d{6}(-\\d{1,3})?(-s\\d{1,10})?(-auto)?\\.npmpro$",
				"maxLength": 255
			},
			"required": true,
			"example": "npmpro-backup-npmpro-20261026-120000.npmpro"
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/octet-stream": {
					"schema": {
						"type": "string",
						"format": "binary"
					}
				}
			}
		}
	}
}
