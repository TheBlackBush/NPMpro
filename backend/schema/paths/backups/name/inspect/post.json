{
	"operationId": "inspectBackup",
	"summary": "Open a stored backup for a restore",
	"description": "Admin only. Unpacks the backup and returns a restore token with what a restore would change. The token expires; cancel it with DELETE /backups/restore/{token}. Errors carry a backup.error.<code> message id: invalid-types, weak-passphrase, wrong-passphrase, not-a-backup (404), invalid-archive, newer-format, too-large (413), busy (409), token-expired (410), name-taken, restore-failed.",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "name",
			"description": "Backup file name",
			"schema": {
				"type": "string",
				"pattern": "^npmpro-backup-[a-z0-9-]+-\\d{8}-\\d{6}(-\\d{1,3})?(-s\\d{1,10})?(-auto)?\\.npmpro$",
				"maxLength": 255
			},
			"required": true,
			"example": "npmpro-backup-npmpro-20261026-120000.npmpro"
		}
	],
	"requestBody": {
		"description": "Inspect options",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"passphrase": {
							"type": "string",
							"minLength": 12,
							"maxLength": 1024,
							"description": "Passphrase, at least 12 characters, never stored"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"token",
							"summary",
							"manifest",
							"preview"
						],
						"properties": {
							"token": {
								"type": "string"
							},
							"summary": {
								"type": "object",
								"additionalProperties": true
							},
							"manifest": {
								"type": "object",
								"additionalProperties": true,
								"required": [
									"types",
									"counts",
									"secrets",
									"npmpro_version",
									"created_at",
									"created_by"
								],
								"properties": {
									"format": {
										"type": "integer"
									},
									"types": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"counts": {
										"type": "object",
										"additionalProperties": {
											"type": "integer"
										}
									},
									"secrets": {
										"type": "boolean"
									},
									"npmpro_version": {
										"type": "string"
									},
									"created_at": {
										"type": "string"
									},
									"created_by": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"name": {
												"type": "string"
											},
											"email": {
												"type": "string"
											}
										}
									},
									"db_version": {
										"type": "string"
									},
									"db_migrations": {
										"type": "array",
										"items": {
											"type": "string"
										}
									}
								}
							},
							"preview": {
								"$ref": "../../../../components/backup-preview-object.json"
							}
						}
					}
				}
			}
		}
	}
}
