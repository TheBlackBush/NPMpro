{
	"operationId": "openBackupImport",
	"summary": "Open an uploaded file for a page import",
	"description": "Decrypts and unpacks the upload and returns a restore token (valid 30 minutes) with the merge plan of the default choices. Use the token with POST /backups/restore/{token}/plan and POST /backups/restore/{token} (mode merge). A wrong or missing passphrase keeps the upload for another try; any other failure uses it up. A user who is no administrator cannot import items holding settings only administrators may set (advanced nginx config, file serving outside /var/www, values outside the API patterns): invalid-item. Errors carry a backup.error.<code> message id: wrong-passphrase, wrong-kind, invalid-item, token-expired (410), busy.\nNeeds: manage on the section of the chosen kind (Proxy Hosts, Redirection Hosts, 404 Hosts, Streams, Access Lists or Certificates; DNS credentials use Certificates), and the user who uploaded the file",
	"tags": [
		"Backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "id",
			"description": "Id returned by the upload call",
			"required": true,
			"schema": {
				"type": "string",
				"pattern": "^[A-Za-z0-9_-]{1,128}$"
			}
		}
	],
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"passphrase": {
							"type": "string",
							"minLength": 1,
							"maxLength": 1024,
							"description": "The passphrase of an encrypted file; leave it out for one that is not."
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"passphrase": "YOUR_PASSPHRASE"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The restore token, what the file holds and the merge plan",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"token",
							"summary",
							"manifest",
							"plan"
						],
						"properties": {
							"token": {
								"type": "string",
								"description": "The restore token (a short-lived session, not a secret to keep)."
							},
							"summary": {
								"type": [
									"object",
									"null"
								],
								"additionalProperties": true,
								"description": "What the file says it holds, read from its header."
							},
							"manifest": {
								"type": "object",
								"additionalProperties": true,
								"description": "The file's contents list: parts, counts, whether it has secrets, the version and user that made it."
							},
							"plan": {
								"$ref": "../../../../../components/backup-plan-object.json"
							}
						}
					},
					"examples": {
						"default": {
							"value": {
								"token": "Xk3p9Zr2QvT7mW1c",
								"summary": {
									"format": 1,
									"types": [
										"proxy_hosts",
										"certificates",
										"access_lists"
									],
									"counts": {
