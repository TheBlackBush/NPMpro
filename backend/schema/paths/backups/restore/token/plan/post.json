{
	"operationId": "planBackupMerge",
	"summary": "Plan a merge restore (dry run)",
	"description": "Shows what a merge of the chosen parts or items of the session would do with every item, and changes nothing. A Settings session (from inspect) is planned by an administrator, a page import session (from import open) by its importer. Send the plan's hash as plan_hash to POST /backups/restore/{token} to apply exactly this plan. An API token cannot plan the Users, settings_oidc or settings_runtime parts. Errors carry a backup.error.<code> message id: invalid-types, token-expired (410), invalid-item.\nNeeds: an administrator for a Settings session (a token needs its Administrator switch); manage on the section of the kind for a page import session",
	"tags": [
		"Backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "token",
			"description": "Restore token returned by the inspect call",
			"schema": {
				"type": "string",
				"pattern": "^[A-Za-z0-9_-]{1,128}$"
			},
			"required": true
		}
	],
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"mode",
						"types"
					],
					"properties": {
						"mode": {
							"type": "string",
							"enum": [
								"merge"
							],
							"description": "Always merge: only a merge is planned."
						},
						"types": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_landing_pages",
									"settings_oidc",
									"settings_monitoring",
									"settings_crowdsec",
									"custom_nginx",
									"crowdsec_files",
									"backup_schedules"
								]
							},
							"minItems": 1,
							"uniqueItems": true,
							"description": "Backup types"
						},
						"items": {
							"type": "object",
							"description": "Chosen item ids per type",
							"additionalProperties": {
								"type": "array",
								"items": {
									"type": "integer",
									"minimum": 1
								},
								"uniqueItems": true
							},
							"propertyNames": {
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_landing_pages",
									"settings_oidc",
									"settings_monitoring",
									"settings_crowdsec",
									"custom_nginx",
									"crowdsec_files",
									"backup_schedules"
								]
							}
						},
						"choices": {
							"type": "object",
							"description": "Choice per item key (for example proxy_hosts:3, setting:oidc, file:custom_nginx/http.conf)",
							"additionalProperties": {
								"type": "string",
								"enum": [
									"skip",
									"replace",
									"existing",
									"add",
									"keep",
									"take",
									"unticked"
								]
							},
							"propertyNames": {
								"type": "string",
								"pattern": "^[a-z_]+:.+$",
								"maxLength": 512
							}
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"mode": "merge",
							"types": [
								"proxy_hosts",
								"certificates"
							],
							"items": {
								"proxy_hosts": [
									12
								]
							},
							"choices": {
								"certificates:5": "existing"
							}
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "The merge plan",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../../components/backup-plan-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"items": [
									{
										"key": "proxy_hosts:12",
										"type": "proxy_hosts",
										"id": 12,
										"label": "app.example.com",
										"action": "add",
										"reason": null,
										"target": null,
										"choices": [],
										"default": "add",
										"needed_by": [],
										"linked": false
									},
									{
										"key": "certificates:5",
										"type": "certificates",
										"id": 5,
										"label": "app.example.com",
										"action": "existing",
										"reason": "same-certificate",
										"target": {
											"type": "certificates",
											"id": 9,
											"label": "app.example.com"
										},
										"choices": [
											"existing",
											"add"
										],
										"default": "existing",
										"needed_by": [
											"proxy_hosts:12"
										],
										"linked": true
									}
								],
								"counts": {
									"add": 1,
									"replace": 0,
									"skip": 0,
									"existing": 1,
									"take": 0,
									"keep": 0
								},
								"cleared_links": [],
								"needs_secrets": [],
								"hash": "9f2b6c1d4e7a3085"
							}
						}
					}
				}
			}
		},
		"409": {
			"description": "Plan changed: the instance changed since the plan was made; the error carries the new plan",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"error"
						],
						"properties": {
							"error": {
								"type": "object",
								"additionalProperties": false,
								"required": [
									"code",
									"message",
									"message_i18n",
									"plan"
								],
								"properties": {
									"code": {
										"type": "integer",
										"enum": [
											409
										]
									},
									"message": {
										"type": "string"
									},
									"message_i18n": {
										"type": "string",
										"enum": [
											"backup.error.plan-changed"
										]
									},
									"plan": {
										"$ref": "../../../../../components/backup-plan-object.json"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
