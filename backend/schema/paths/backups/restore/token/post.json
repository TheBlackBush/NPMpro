{
	"operationId": "restoreBackup",
	"summary": "Restore a backup (replace or merge)",
	"description": "Admin only. Replace (default) replaces the chosen types with the backup's after an automatic backup. Merge adds the chosen items to the instance and needs the plan_hash of the plan the user confirmed; when the instance changed since, the call fails with 409 plan-changed and the error carries the new plan. The request can take long: a running certificate renewal is waited for. Errors carry a backup.error.<code> message id: invalid-types, weak-passphrase, wrong-passphrase, not-a-backup (404), invalid-archive, newer-format, too-large (413), busy (409), token-expired (410), name-taken, restore-failed, plan-changed (409), partial-replace, wrong-kind, not-importable.",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "token",
			"description": "Restore token returned by the inspect call",
			"schema": {
				"type": "string",
				"pattern": "^[A-Za-z0-9_-]{1,128}$"
			},
			"required": true
		}
	],
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"types"
					],
					"properties": {
						"mode": {
							"type": "string",
							"enum": [
								"replace",
								"merge"
							],
							"default": "replace"
						},
						"types": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_oidc",
									"settings_monitoring",
									"custom_nginx",
									"crowdsec_files"
								]
							},
							"minItems": 1,
							"uniqueItems": true,
							"description": "Backup types"
						},
						"items": {
							"type": "object",
							"description": "Chosen item ids per type",
							"additionalProperties": {
								"type": "array",
								"items": {
									"type": "integer",
									"minimum": 1
								},
								"uniqueItems": true
							},
							"propertyNames": {
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_oidc",
									"settings_monitoring",
									"custom_nginx",
									"crowdsec_files"
								]
							}
						},
						"choices": {
							"type": "object",
							"description": "Choice per item key (for example proxy_hosts:3, setting:oidc, file:custom_nginx/http.conf)",
							"additionalProperties": {
								"type": "string",
								"enum": [
									"skip",
									"replace",
									"existing",
									"add",
									"keep",
									"take",
									"unticked"
								]
							},
							"propertyNames": {
								"type": "string",
								"pattern": "^[a-z_]+:.+$",
								"maxLength": 512
							}
						},
						"plan_hash": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128,
							"description": "Hash of the confirmed plan, required for mode merge"
						},
						"confirm": {
							"type": "boolean",
							"enum": [
								true
							],
							"description": "Required for mode replace"
						}
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"mode": {
										"const": "merge"
									}
								},
								"required": [
									"mode"
								]
							},
							"then": {
								"required": [
									"plan_hash"
								]
							},
							"else": {
								"required": [
									"confirm"
								]
							}
						}
					]
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": true,
						"required": [
							"counts",
							"restartNeeded",
							"runtimeFailed",
							"offlineHosts"
						],
						"properties": {
							"counts": {
								"type": "object",
								"additionalProperties": {
									"type": "integer"
								}
							},
							"references": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": true
								}
							},
							"skippedUsers": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": true
								}
							},
							"restartNeeded": {
								"type": "boolean"
							},
							"runtimeFailed": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Settings groups that could not be applied"
							},
							"offlineHosts": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"type",
										"id",
										"domain",
										"error"
									],
									"properties": {
										"type": {
											"type": "string"
										},
										"id": {
											"type": "integer"
										},
										"domain": {
											"type": "string"
										},
										"error": {
											"type": "string"
										}
									}
								}
							},
							"cleared": {
								"type": "array",
								"description": "Merge only: links that were cleared",
								"items": {
									"type": "object",
									"additionalProperties": true
								}
							},
							"needsSecrets": {
								"type": "array",
								"description": "Merge only: keys of items that need secrets the file did not have",
								"items": {
									"type": "string"
								}
							}
						},
						"description": "Replace returns references and skippedUsers; merge returns cleared and needsSecrets"
					}
				}
			}
		},
		"409": {
			"description": "409 plan-changed: the instance changed since the plan was made; the error carries the new plan",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"error"
						],
						"properties": {
							"error": {
								"type": "object",
								"additionalProperties": false,
								"required": [
									"code",
									"message",
									"message_i18n",
									"plan"
								],
								"properties": {
									"code": {
										"type": "integer",
										"enum": [
											409
										]
									},
									"message": {
										"type": "string"
									},
									"message_i18n": {
										"type": "string",
										"enum": [
											"backup.error.plan-changed"
										]
									},
									"plan": {
										"$ref": "../../../../components/backup-plan-object.json"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
