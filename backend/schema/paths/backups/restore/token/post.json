{
	"operationId": "restoreBackup",
	"summary": "Restore a backup (replace or merge)",
	"description": "Replace (the default, for a stored backup only) deletes every row of the chosen parts and puts the backup's in their place, after an automatic backup, and needs confirm true. It signs out the other users when the Users part is restored, and deletes their API tokens (a backup never carries tokens). Merge adds the chosen items without deleting anything and needs the plan_hash of the plan you confirmed; when the instance changed since, it fails with 409 plan-changed and the error carries the new plan. Both roll back completely when nginx refuses the result. The request can take long: a running certificate renewal is waited for. An API token cannot restore or merge the Users, settings_oidc or settings_runtime parts, and a token's replace needs its Allow delete switch. Errors carry a backup.error.<code> message id: invalid-types, partial-replace (a file of single items can only be merged), plan-changed (409), restore-failed, invalid-item, token-expired (410), busy (409).\n\nNeeds: an administrator for a Settings session, and for a replace a token's Allow delete switch; manage on the section of the kind for a page import session (merge only)",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "token",
			"description": "Restore token returned by the inspect call",
			"schema": {
				"type": "string",
				"pattern": "^[A-Za-z0-9_-]{1,128}$"
			},
			"required": true
		}
	],
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"types"
					],
					"properties": {
						"mode": {
							"type": "string",
							"enum": [
								"replace",
								"merge"
							],
							"default": "replace",
							"description": "replace (the default) or merge."
						},
						"types": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_landing_pages",
									"settings_oidc",
									"settings_monitoring",
									"settings_crowdsec",
									"custom_nginx",
									"crowdsec_files",
									"backup_schedules"
								]
							},
							"minItems": 1,
							"uniqueItems": true,
							"description": "Backup types"
						},
						"items": {
							"type": "object",
							"description": "Chosen item ids per type",
							"additionalProperties": {
								"type": "array",
								"items": {
									"type": "integer",
									"minimum": 1
								},
								"uniqueItems": true
							},
							"propertyNames": {
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_landing_pages",
									"settings_oidc",
									"settings_monitoring",
									"settings_crowdsec",
									"custom_nginx",
									"crowdsec_files",
									"backup_schedules"
								]
							}
						},
						"choices": {
							"type": "object",
							"description": "Choice per item key (for example proxy_hosts:3, setting:oidc, file:custom_nginx/http.conf)",
							"additionalProperties": {
								"type": "string",
								"enum": [
									"skip",
									"replace",
									"existing",
									"add",
									"keep",
									"take",
									"unticked"
								]
							},
							"propertyNames": {
								"type": "string",
								"pattern": "^[a-z_]+:.+$",
								"maxLength": 512
							}
						},
						"plan_hash": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128,
							"description": "Hash of the confirmed plan, required for mode merge"
						},
						"confirm": {
							"type": "boolean",
							"enum": [
								true
							],
							"description": "Required for mode replace"
						}
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"mode": {
										"const": "merge"
									}
								},
								"required": [
									"mode"
								]
							},
							"then": {
								"required": [
									"plan_hash"
								]
							},
							"else": {
								"required": [
									"confirm"
								]
							}
						}
					]
				},
				"examples": {
					"default": {
						"value": {
							"mode": "replace",
							"types": [
								"proxy_hosts",
								"certificates"
							],
							"confirm": true
						}
					},
					"merge": {
						"value": {
							"mode": "merge",
							"types": [
								"proxy_hosts",
								"certificates"
							],
							"items": {
								"proxy_hosts": [
									12
								]
							},
							"choices": {
								"certificates:5": "existing"
							},
							"plan_hash": "9f2b6c1d4e7a3085"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "What the restore did: counts per part, whether a restart is needed, settings that could not be applied, hosts nginx refused, and for a replace its references and skipped users or for a merge its cleared links and items that need secrets",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": true,
						"required": [
							"counts",
							"restartNeeded",
							"runtimeFailed",
							"offlineHosts"
						],
						"properties": {
							"counts": {
								"type": "object",
								"additionalProperties": {
									"type": "integer"
								},
								"description": "Replace: rows restored per part. Merge: items per action (add, replace, skip, existing, take, keep)."
							},
							"references": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": true
								},
								"description": "Replace only: references to rows that do not exist after the restore, cleared or moved to the restoring administrator."
							},
							"skippedUsers": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": true
								},
								"description": "Replace only: backup users that were not restored because they are the restoring administrator."
							},
							"restartNeeded": {
								"type": "boolean",
								"description": "Whether restored settings only apply after the container restarts."
							},
							"runtimeFailed": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Settings groups that could not be applied"
							},
							"offlineHosts": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"type",
										"id",
										"domain",
										"error"
									],
									"properties": {
										"type": {
											"type": "string",
											"description": "The host type: proxy, redirection, dead or stream."
										},
										"id": {
											"type": "integer",
											"description": "The host's id."
										},
										"domain": {
											"type": "string",
											"description": "What the host is called in lists: its domains, or its port for a stream."
										},
										"error": {
											"type": "string",
											"description": "The nginx error that took the host offline."
										}
									}
								},
								"description": "Hosts that nginx refused after the restore: they are taken offline and need fixing on their host page."
							},
							"cleared": {
								"type": "array",
								"description": "Merge only: links that were cleared",
								"items": {
									"type": "object",
									"additionalProperties": true
								}
							},
							"needsSecrets": {
								"type": "array",
								"description": "Merge only: keys of items that need secrets the file did not have",
								"items": {
									"type": "string"
								}
							}
						},
						"description": "Replace returns references and skippedUsers; merge returns cleared and needsSecrets"
					},
					"examples": {
						"default": {
							"value": {
								"counts": {
									"proxy_hosts": 12,
									"certificates": 5
								},
								"references": [],
								"skippedUsers": [
									{
										"id": 1,
										"email": "admin@example.com",
										"name": "Jane Doe"
									}
								],
								"restartNeeded": false,
								"runtimeFailed": [],
								"offlineHosts": []
							}
						},
						"merge": {
							"value": {
								"counts": {
									"add": 1,
									"existing": 1
								},
								"cleared": [],
								"needsSecrets": [],
								"restartNeeded": false,
								"runtimeFailed": [],
								"offlineHosts": []
							}
						}
					}
				}
			}
		},
		"409": {
			"description": "Plan changed: the instance changed since the plan was made; the error carries the new plan",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"error"
						],
						"properties": {
							"error": {
								"type": "object",
								"additionalProperties": false,
								"required": [
									"code",
									"message",
									"message_i18n",
									"plan"
								],
								"properties": {
									"code": {
										"type": "integer",
										"enum": [
											409
										]
									},
									"message": {
										"type": "string"
									},
									"message_i18n": {
										"type": "string",
										"enum": [
											"backup.error.plan-changed"
										]
									},
									"plan": {
										"$ref": "../../../../components/backup-plan-object.json"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
