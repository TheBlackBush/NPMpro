{
	"operationId": "checkBackupRestore",
	"summary": "Preview a replace restore of chosen parts",
	"description": "Shows what a replace restore of the chosen parts of the session would change: references that would be cleared, users that are skipped and parts whose secrets the file lacks. It changes nothing. Errors carry a backup.error.<code> message id: invalid-types, token-expired (410).\n\nNeeds: an administrator (a token needs its Administrator switch)",
	"tags": [
		"backups"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "token",
			"description": "Restore token returned by the inspect call",
			"schema": {
				"type": "string",
				"pattern": "^[A-Za-z0-9_-]{1,128}$"
			},
			"required": true
		}
	],
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"types"
					],
					"properties": {
						"types": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"proxy_hosts",
									"redirection_hosts",
									"dead_hosts",
									"streams",
									"certificates",
									"access_lists",
									"dns_credentials",
									"ddns",
									"users",
									"settings_runtime",
									"settings_default_site",
									"settings_landing_pages",
									"settings_oidc",
									"settings_notifications",
									"settings_monitoring",
									"settings_crowdsec",
									"custom_nginx",
									"crowdsec_files",
									"backup_schedules",
									"webhooks"
								]
							},
							"minItems": 1,
							"uniqueItems": true,
							"description": "The parts to preview; all of them must be in the backup."
						}
					}
				},
				"examples": {
					"default": {
						"value": {
							"types": [
								"proxy_hosts",
								"certificates"
							]
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "What a replace restore of these parts would change",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../../components/backup-preview-object.json"
					},
					"examples": {
						"default": {
							"value": {
								"references": [
									{
										"table": "proxy_host",
										"id": 12,
										"column": "certificate_id",
										"from": 5,
										"to": null,
										"label": "app.example.com"
									}
								],
								"skippedUsers": [
									{
										"id": 1,
										"email": "admin@example.com",
										"name": "Jane Doe"
									}
								],
								"missingSecrets": []
							}
						}
					}
				}
			}
		}
	}
}
