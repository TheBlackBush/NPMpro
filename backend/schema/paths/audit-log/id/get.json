{
	"operationId": "getAuditLog",
	"summary": "Get an audit log entry",
	"tags": [
		"audit-log"
	],
	"security": [
		{
			"cookieAuth": []
		},
		{
			"bearerAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "id",
			"description": "ID of the audit log entry",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		},
		{
			"in": "query",
			"name": "expand",
			"description": "Relations to add: `user` adds the user who acted",
			"schema": {
				"type": "string",
				"enum": [
					"user"
				]
			}
		}
	],
	"responses": {
		"200": {
			"description": "The audit log entry",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 42,
								"created_on": "2026-11-17T09:30:00.000Z",
								"modified_on": "2026-11-17T09:30:00.000Z",
								"user_id": 1,
								"object_type": "proxy-host",
								"object_id": 12,
								"action": "updated",
								"meta": {
									"domain_names": [
										"app.example.com"
									]
								},
								"npmpro_api_token_id": null,
								"npmpro_api_token_name": null
							}
						}
					},
					"schema": {
						"$ref": "../../../components/audit-log-object.json"
					}
				}
			}
		}
	},
	"description": "Returns one audit log entry. Add `expand=user` to include the user who acted. 404 when no entry has this ID.\n\nNeeds: an administrator (a token needs its Administrator switch)"
}
