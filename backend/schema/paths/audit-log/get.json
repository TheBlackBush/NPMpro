{
	"operationId": "getAuditLogs",
	"summary": "Get Audit Logs",
	"tags": [
		"audit-log"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "expand",
			"description": "Expansions",
			"schema": {
				"type": "string",
				"enum": [
					"user"
				]
			}
		},
		{
			"in": "query",
			"name": "query",
			"description": "Search text matched against the entry meta",
			"schema": {
				"type": "string"
			}
		},
		{
			"in": "query",
			"name": "limit",
			"description": "Page size",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 200,
				"default": 50
			}
		},
		{
			"in": "query",
			"name": "offset",
			"description": "Number of entries to skip",
			"schema": {
				"type": "integer",
				"minimum": 0,
				"default": 0
			}
		},
		{
			"in": "query",
			"name": "object_type",
			"description": "Filter by object type",
			"schema": {
				"type": "string",
				"enum": [
					"proxy-host",
					"redirection-host",
					"dead-host",
					"stream",
					"access-list",
					"certificate",
					"dns-credential",
					"user",
					"setting",
					"backup-schedule",
					"database"
				]
			}
		},
		{
			"in": "query",
			"name": "action",
			"description": "Filter by action",
			"schema": {
				"type": "string",
				"enum": [
					"created",
					"updated",
					"deleted",
					"enabled",
					"disabled",
					"backup-succeeded",
					"backup-failed",
					"moved",
					"move-failed"
				]
			}
		},
		{
			"in": "query",
			"name": "user_id",
			"description": "Filter by user ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			}
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 7,
									"created_on": "2024-10-08T13:09:54.000Z",
									"modified_on": "2024-10-08T13:09:54.000Z",
									"user_id": 1,
									"object_type": "user",
									"object_id": 3,
									"action": "updated",
									"meta": {
										"name": "John Doe",
										"permissions": {
											"user_id": 3,
											"visibility": "all",
											"access_lists": "manage",
											"dead_hosts": "hidden",
											"proxy_hosts": "manage",
											"redirection_hosts": "view",
											"streams": "hidden",
											"certificates": "manage",
											"id": 3,
											"modified_on": "2024-10-08T13:09:54.000Z",
											"created_on": "2024-10-08T13:09:51.000Z"
										}
									}
								}
							]
						}
					},
					"schema": {
						"$ref": "../../components/audit-log-list.json"
					}
				}
			},
			"headers": {
				"X-Total-Count": {
					"description": "Total number of entries matching the filter",
					"schema": {
						"type": "integer"
					}
				}
			}
		}
	}
}
