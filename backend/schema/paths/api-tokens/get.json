{
	"operationId": "getApiTokens",
	"summary": "List every user's API tokens",
	"tags": [
		"api-tokens"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "Every API token with its owner, newest first",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"name": "deploy script",
									"prefix": "npmpro_3f9c2a7d1b4e8f60",
									"visibility": "user",
									"permissions": {
										"proxy_hosts": "manage",
										"redirection_hosts": "view",
										"dead_hosts": "hidden",
										"streams": "hidden",
										"access_lists": "view",
										"certificates": "view"
									},
									"admin": false,
									"allow_delete": false,
									"expires_on": "2027-02-15T09:30:00.000Z",
									"last_used_on": null,
									"created_on": "2026-11-17T09:30:00.000Z",
									"expired": false,
									"owner": {
										"id": 2,
										"name": "Jane Doe",
										"email": "jane@example.com"
									}
								}
							]
						}
					},
					"schema": {
						"type": "array",
						"items": {
							"$ref": "../../components/api-token-object.json"
						}
					}
				}
			}
		},
		"403": {
			"description": "Not allowed: the request was made with an API token, or the user is not an administrator"
		}
	},
	"description": "Lists the API tokens of all users, newest first, each with its owner. The token text is never in the list.\n\nNeeds: a signed-in session of an administrator (API tokens are refused)"
}
